---
import { Image } from 'astro:assets';
import Encabezado from './Encabezado.astro';
import Icono from './Icono.astro';
import { seccionCatalogo as s } from '../data/sitio';

const { destacados } = Astro.locals.sitio;
---

<section id="equipos" class="seccion relative" aria-labelledby="titulo-equipos">
  <!-- Transductor 3D (Three.js) en el hueco del encabezado. Sin JS o sin WebGL queda vacío. -->
  <div class="transductor-3d" aria-hidden="true" data-transductor-3d></div>
  <div class="contenedor">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
      <Encabezado etiqueta={s.etiqueta} titulo={s.titulo} id="titulo-equipos" class="lg:col-span-7" />
      <p class="texto-suave max-w-md lg:col-span-4 lg:col-start-9">{s.texto}</p>
    </div>

    <div class="mt-12 lg:mt-16" data-reveal>
      <ul class="carrusel" role="list">
        {
          destacados.map((e) => (
            <li class="tarjeta">
              <div class="cara">
                <div class="foto">
                  <span class="escuadra marco" aria-hidden="true" />
                  {(e.descuento || e.agotado) && (
                    <span class:list={['insignia', e.agotado && 'insignia-agotado']}>{e.agotado ? s.agotado : e.descuento}</span>
                  )}
                  <Image
                    src={e.imagen.src}
                    width={e.imagen.width}
                    height={e.imagen.height}
                    alt={e.imagenAlt}
                    widths={[384, 640, 828]}
                    sizes="(min-width: 1280px) 340px, (min-width: 1024px) 27vw, (min-width: 768px) 42vw, 64vw"
                    quality={80}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="flex flex-1 flex-col p-6">
                  <span class="text-xs font-semibold uppercase tracking-wider text-marca mb-1">{e.tipo || e.categoria.nombre}</span>
                  <h3 class="text-2xl font-semibold tracking-tight">
                    <a href={`/equipos/${e.slug}`} class="-my-1.5 block py-1.5 transition-colors hover:text-marca">
                      {e.nombreCompleto}
                    </a>
                  </h3>
                  {e.especificaciones.length > 0 && (
                    <ul class="texto-suave mt-3 space-y-1.5 text-[0.9375rem]" role="list">
                      {e.especificaciones.slice(0, 3).map((esp) => (
                        <li class="flex gap-2.5 before:mt-[0.6em] before:size-1 before:flex-none before:rounded-full before:bg-marca">
                          {esp}
                        </li>
                      ))}
                    </ul>
                  )}
                  <div class="mt-auto pt-6 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100">
                    <a href={`/equipos/${e.slug}`} class="inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-slate-700 transition-colors hover:text-marca">
                      <span>{s.verDetalle}</span>
                      <Icono nombre="flecha" class="size-3.5" />
                    </a>
                    <a href="#contacto" data-equipo={e.nombreCompleto} class="btn btn-primario btn-chico">
                      {e.agotado ? s.ctaAgotado : s.cta}
                    </a>
                  </div>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
      <div class="progreso" aria-hidden="true"><span></span></div>
    </div>
  </div>
</section>

<style>
  /* 44 px: lo mínimo cómodo para el dedo, igual que los enlaces de la tarjeta. */
  .btn-chico {
    min-height: 2.75rem;
    padding-inline: 0.875rem;
    font-size: 0.8125rem;
  }
  .carrusel {
    display: flex;
    gap: 1rem;
    margin-inline: -1rem;
    padding: 0.25rem 1rem 0.5rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 1rem;
    scrollbar-width: none;
  }
  .carrusel::-webkit-scrollbar {
    display: none;
  }
  /* El <li> queda plano (recibe el puntero y el snap); la .cara es la que se inclina en 3D. */
  .tarjeta {
    display: flex;
    flex: 0 0 78%;
    scroll-snap-align: start;
    perspective: 60rem;
  }
  .cara {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    border: 1px solid color-mix(in srgb, var(--color-tinta) 10%, transparent);
    background: #fff;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  @media (width >= 48rem) {
    .carrusel {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
      margin-inline: 0;
      padding: 0;
      overflow: visible;
    }
  }
  @media (width >= 64rem) {
    .carrusel {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Etiqueta de descuento o «Agotado» sobre la foto (se edita en el admin). */
  .insignia {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 2;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    background: var(--color-marca);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .insignia-agotado {
    background: var(--color-tinta);
  }
  .foto {
    position: relative;
    aspect-ratio: 1;
    padding: 1.25rem;
    background: linear-gradient(180deg, #fff, var(--color-roto));
  }
  /* Encuadre en escuadra que aparece al pasar el cursor */
  .marco {
    position: absolute;
    inset: 0.75rem;
    --l: 1rem;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: translate 0.3s ease;
  }

  .tarjeta:is(:hover, :focus-within) .cara {
    border-color: var(--color-marca);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
  }
  .tarjeta:is(:hover, :focus-within) .marco {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .tarjeta:hover .foto :global(img) {
      translate: 0 -0.375rem;
    }
    .tarjeta:is(:hover, :focus-within) .enlace :global(svg) {
      translate: 0.25rem 0;
    }

    /* Profundidad: la foto y la escuadra flotan en planos propios al pasar el cursor o con el foco
       (el teclado recibe el mismo despegue, sin inclinar el texto). En reposo no hay transformaciones. */
    .cara,
    .foto {
      transform-style: preserve-3d;
    }
    .foto :global(img) {
      transition: translate 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .marco {
      transition:
        opacity 0.2s ease,
        translate 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .tarjeta:is(:hover, :focus-within) .foto :global(img) {
      translate: 0 -0.375rem 3rem;
    }
    .tarjeta:is(:hover, :focus-within) .marco {
      translate: 0 0 1.25rem;
    }
  }

  /* Con mouse: la cara voltea hacia el cursor (--px/--py de -1 a 1, los escribe el script) y un foco azul
     tenue sigue al puntero detrás del equipo. */
  @media (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .cara {
      transition:
        transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1),
        border-color 0.2s ease,
        box-shadow 0.3s ease;
    }
    .tarjeta:hover .cara {
      transform: rotateX(calc(var(--py, 0) * -4deg)) rotateY(calc(var(--px, 0) * 6deg));
      box-shadow: 0 1.75rem 3rem -1.75rem color-mix(in srgb, var(--color-tinta) 35%, transparent);
    }
    .foto::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(
        circle at calc(50% + var(--px, 0) * 35%) calc(45% + var(--py, 0) * 35%),
        color-mix(in srgb, var(--color-marca) 13%, transparent),
        transparent 62%
      );
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    .tarjeta:hover .foto::before {
      opacity: 1;
    }
  }

  /* Móvil: el carrusel horizontal gira como coverflow según la posición de cada tarjeta.
     Meseta en 40–62 %: la tarjeta asentada por el snap (≈56 %, o ≈44 % la última) queda plana y nítida. */
  @supports (animation-timeline: view(inline)) {
    @media (width < 48rem) and (prefers-reduced-motion: no-preference) {
      .cara {
        animation: girar linear both;
        animation-timeline: view(inline);
      }
    }
  }
  @keyframes girar {
    from {
      rotate: y -26deg;
      scale: 0.9;
    }
    40%,
    62% {
      rotate: none;
      scale: none;
    }
    to {
      rotate: y 26deg;
      scale: 0.9;
    }
  }

  /* Hueco del encabezado donde flota el transductor: arriba a la derecha, nunca sobre el texto.
     Móvil: a la derecha de la etiqueta, encima del título. md: a la derecha del título (12.6em es su
     primera línea). lg: sobre el párrafo; la altura deja libre su primera línea con 3 renglones. */
  .transductor-3d {
    position: absolute;
    top: 0;
    right: 0;
    left: 11.5rem;
    height: 6.75rem;
    pointer-events: none;
    contain: layout style paint;
    will-change: transform;
    /* El cable se desvanece hacia el borde derecho y la sombra hacia abajo. */
    mask-image: linear-gradient(to left, transparent, #000 3rem), linear-gradient(to top, transparent, #000 1.25rem);
    mask-composite: intersect;
  }
  @media (width >= 48rem) {
    .transductor-3d {
      left: calc(3rem + 12.6 * (1.35rem + 2.2vw));
      height: 17rem;
    }
  }
  @media (width >= 64rem) {
    .transductor-3d {
      left: 58%;
      right: 0; /* hasta el borde de la ventana: el cable sale de la pantalla en vez de cortarse en el aire */
      height: 10.25rem;
    }
  }
  @media (width >= 80rem) {
    .transductor-3d {
      height: 12rem;
    }
  }

  /* Avance del carrusel en móvil: animación ligada al scroll, solo CSS. */
  .progreso {
    display: none;
  }
  @supports (animation-timeline: scroll()) and (timeline-scope: none) {
    [data-reveal]:has(> .carrusel) {
      timeline-scope: --carrusel;
    }
    .carrusel {
      scroll-timeline: --carrusel x;
    }
    .progreso {
      display: block;
      height: 2px;
      margin: 1rem auto 0;
      max-width: 8rem;
      overflow: hidden;
      border-radius: 999px;
      background: color-mix(in srgb, var(--color-tinta) 12%, transparent);
    }
    .progreso span {
      display: block;
      height: 100%;
      background: var(--color-marca);
      transform-origin: left;
      animation: avance linear both;
      animation-timeline: --carrusel;
    }
    @media (width >= 48rem) {
      .progreso {
        display: none;
      }
    }
  }
  @keyframes avance {
    from {
      scale: 0.22 1;
    }
    to {
      scale: 1 1;
    }
  }
</style>

<script>
  import { montar3d } from '../scripts/escena3d';

  // Armar el transductor (reflejos y geometría) cuesta ~0.3 s de CPU en un celular: se precarga a los 5 s, cuando ya
  // terminó la entrada del hero, para que llegar al catálogo no dé un tirón. Si el usuario llega antes, se arma ahí.
  const transductor = document.querySelector<HTMLElement>('[data-transductor-3d]');
  if (transductor) montar3d(transductor, () => import('../scripts/escenas/transductor'), 5000);

  // Inclinación de las tarjetas hacia el cursor: un solo listener delegado y una escritura por cuadro.
  const carrusel = document.querySelector<HTMLElement>('#equipos .carrusel');
  if (carrusel && matchMedia('(pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
    let activa: HTMLElement | null = null;
    let rect: DOMRect | null = null;
    let cursor = { x: 0, y: 0 };
    let cuadro = 0;
    const soltar = () => {
      activa?.style.removeProperty('--px');
      activa?.style.removeProperty('--py');
      activa = null;
      rect = null;
    };
    carrusel.addEventListener('pointermove', (ev) => {
      if (ev.pointerType === 'touch') return;
      const tarjeta = (ev.target as Element).closest<HTMLElement>('.tarjeta');
      if (tarjeta !== activa) {
        soltar();
        if (tarjeta) {
          activa = tarjeta;
          rect = activa.getBoundingClientRect();
        }
      }
      if (!activa || !rect) return;
      cursor = { x: ev.clientX, y: ev.clientY };
      cuadro ||= requestAnimationFrame(() => {
        cuadro = 0;
        if (!activa || !rect) return;
        activa.style.setProperty('--px', (((cursor.x - rect.left) / rect.width) * 2 - 1).toFixed(3));
        activa.style.setProperty('--py', (((cursor.y - rect.top) / rect.height) * 2 - 1).toFixed(3));
      });
    });
    carrusel.addEventListener('pointerleave', soltar);
  }
</script>
