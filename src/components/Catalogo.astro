---
import { Picture } from 'astro:assets';
import Encabezado from './Encabezado.astro';
import Icono from './Icono.astro';
import { equipos, seccionEquipos as s } from '../data/equipos';
---

<section id="equipos" class="seccion" aria-labelledby="titulo-equipos">
  <div class="contenedor">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
      <Encabezado etiqueta={s.etiqueta} titulo={s.titulo} id="titulo-equipos" class="lg:col-span-7" />
      <p class="texto-suave max-w-md lg:col-span-4 lg:col-start-9">{s.texto}</p>
    </div>

    <div class="mt-12 lg:mt-16" data-reveal>
      <ul class="carrusel" role="list">
        {
          equipos.map((e) => (
            <li class="tarjeta">
              <div class="foto">
                <span class="escuadra marco" aria-hidden="true" />
                <Picture
                  src={e.imagen}
                  alt={e.imagenAlt}
                  formats={['avif']}
                  fallbackFormat="webp"
                  widths={[320, 480, 640, 800]}
                  sizes="(min-width: 1280px) 340px, (min-width: 1024px) 27vw, (min-width: 768px) 42vw, 64vw"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="flex flex-1 flex-col p-6">
                <span class="text-xs font-semibold uppercase tracking-wider text-marca-claro mb-1">{e.categoria}</span>
                <h3 class="text-2xl font-semibold tracking-tight">
                  <a href={`/equipos/${e.slug}`} class="hover:text-marca transition-colors">
                    Mindray {e.nombre}
                  </a>
                </h3>
                {e.especificaciones.length > 0 && (
                  <ul class="texto-suave mt-3 space-y-1.5 text-[0.9375rem]" role="list">
                    {e.especificaciones.slice(0, 3).map((esp) => (
                      <li class="flex gap-2.5 before:mt-[0.6em] before:size-1 before:flex-none before:rounded-full before:bg-marca">
                        {esp}
                      </li>
                    ))}
                  </ul>
                )}
                <div class="mt-auto pt-6 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100">
                  <a href={`/equipos/${e.slug}`} class="inline-flex items-center gap-1.5 text-sm font-semibold text-slate-700 hover:text-marca transition-colors">
                    <span>Ver detalle</span>
                    <Icono nombre="flecha" class="size-3.5" />
                  </a>
                  <a href="#contacto" data-equipo={e.nombre} class="btn btn-primario btn-chico">
                    {s.cta}
                  </a>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
      <div class="progreso" aria-hidden="true"><span></span></div>
    </div>
  </div>
</section>

<style>
  .btn-chico {
    min-height: 2.25rem;
    padding-inline: 0.875rem;
    font-size: 0.8125rem;
  }
  .carrusel {
    display: flex;
    gap: 1rem;
    margin-inline: -1rem;
    padding: 0.25rem 1rem 0.5rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 1rem;
    scrollbar-width: none;
  }
  .carrusel::-webkit-scrollbar {
    display: none;
  }
  .tarjeta {
    position: relative;
    display: flex;
    flex: 0 0 78%;
    flex-direction: column;
    scroll-snap-align: start;
    border: 1px solid color-mix(in srgb, var(--color-tinta) 10%, transparent);
    background: #fff;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  @media (width >= 48rem) {
    .carrusel {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
      margin-inline: 0;
      padding: 0;
      overflow: visible;
    }
  }
  @media (width >= 64rem) {
    .carrusel {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .foto {
    position: relative;
    aspect-ratio: 1;
    padding: 1.25rem;
    background: linear-gradient(180deg, #fff, var(--color-roto));
  }
  /* Encuadre en escuadra que aparece al pasar el cursor */
  .marco {
    position: absolute;
    inset: 0.75rem;
    --l: 1rem;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: translate 0.3s ease;
  }

  .tarjeta:hover,
  .tarjeta:focus-within {
    border-color: var(--color-marca);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
  }
  .tarjeta:is(:hover, :focus-within) .marco {
    opacity: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .tarjeta:hover .foto :global(img) {
      translate: 0 -0.375rem;
    }
    .tarjeta:is(:hover, :focus-within) .enlace :global(svg) {
      translate: 0.25rem 0;
    }
  }

  /* Avance del carrusel en móvil: animación ligada al scroll, solo CSS. */
  .progreso {
    display: none;
  }
  @supports (animation-timeline: scroll()) and (timeline-scope: none) {
    [data-reveal]:has(> .carrusel) {
      timeline-scope: --carrusel;
    }
    .carrusel {
      scroll-timeline: --carrusel x;
    }
    .progreso {
      display: block;
      height: 2px;
      margin: 1rem auto 0;
      max-width: 8rem;
      overflow: hidden;
      border-radius: 999px;
      background: color-mix(in srgb, var(--color-tinta) 12%, transparent);
    }
    .progreso span {
      display: block;
      height: 100%;
      background: var(--color-marca);
      transform-origin: left;
      animation: avance linear both;
      animation-timeline: --carrusel;
    }
    @media (width >= 48rem) {
      .progreso {
        display: none;
      }
    }
  }
  @keyframes avance {
    from {
      scale: 0.22 1;
    }
    to {
      scale: 1 1;
    }
  }
</style>
