---
import Encabezado from './Encabezado.astro';
import Icono from './Icono.astro';

const googleMapsUrl = 'https://maps.app.goo.gl/DVZiHd1BbWLBJw4N6';
const latitud = 18.8983518;
const longitud = -96.9561195;
---

<section id="mapa" class="oscuro seccion relative overflow-hidden" aria-labelledby="titulo-mapa">
  <!-- Fondo decorativo con resplandor radial -->
  <div class="pointer-events-none absolute -top-40 left-1/2 -z-10 h-96 w-[50rem] -translate-x-1/2 rounded-full bg-(--color-marca) opacity-10 blur-3xl" aria-hidden="true"></div>

  <div class="contenedor grid gap-10 lg:grid-cols-12 lg:items-start">
    <!-- Encabezado y resumen de información -->
    <div class="lg:col-span-12" data-reveal>
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <Encabezado
          etiqueta="Ubicación & Cobertura"
          titulo="Nuestras *oficinas* y centro de atención."
          id="titulo-mapa"
        >
          <p class="texto-suave mt-4 max-w-2xl">
            Visítanos en nuestra sede principal o agenda una demostración en vivo de nuestros equipos de ultrasonido Mindray. Contamos con cobertura de entrega y soporte técnico en todo México.
          </p>
        </Encabezado>

        <a
          href={googleMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-contorno shrink-0 self-start md:self-end"
        >
          <Icono nombre="externo" class="size-4" />
          <span>Abrir en Google Maps</span>
        </a>
      </div>
    </div>

    <!-- Contenedor principal del Mapa Animado -->
    <div class="mesa relative lg:col-span-8" data-reveal>
      <!-- Barra de herramientas superior del mapa -->
      <div class="mb-3 flex flex-wrap items-center justify-between gap-3 rounded-t-lg border border-b-0 border-(--linea) bg-noche/90 px-4 py-3 backdrop-blur-md">
        <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-marca-claro">
          <span class="relative flex size-2.5">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex size-2.5 rounded-full bg-emerald-500"></span>
          </span>
          <span>Sede Matriz • En Vivo</span>
        </div>
      </div>

      <!-- Mapa de Google Maps -->
      <div class="relative h-[420px] w-full overflow-hidden rounded-b-lg border border-(--linea) bg-negro shadow-2xl sm:h-[480px]">
        <div class="absolute inset-0">
          <iframe
            src={`https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3772.378!2d${longitud}!3d${latitud}!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x85c4e5768ebf0871%3A0x512ecb6a4368219e!2sIMAGMED%20NACIONAL!5e0!3m2!1ses!2smx!4v1700000000000!5m2!1ses!2smx`}
            width="100%"
            height="100%"
            style="border:0; filter: invert(90%) hue-rotate(180deg) contrast(120%);"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Ubicación Google Maps de Imagmed Nacional"
          ></iframe>
        </div>
      </div>
    </div>

    <!-- Tarjeta lateral interactiva con información de contacto y presencia nacional -->
    <div class="mesa mesa-lateral lg:col-span-4" data-reveal>
      <div class="escuadra border border-(--linea) bg-noche/95 p-6 sm:p-8 backdrop-blur-xl">
        <div class="flex items-center gap-3">
          <div class="flex size-10 items-center justify-center rounded-lg bg-marca/20 text-marca-claro">
            <Icono nombre="ubicacionPin" class="size-6" />
          </div>
          <div>
            <h3 class="font-bold text-white text-lg leading-tight">IMAGMED NACIONAL</h3>
            <p class="text-xs text-marca-claro font-medium">S.A. DE C.V.</p>
          </div>
        </div>

        <hr class="my-5 border-(--linea)" />

        <div class="space-y-4 text-sm">
          <div>
            <span class="block text-xs uppercase tracking-wider text-suave">Dirección Principal</span>
            <p class="mt-1 font-medium text-white">
              C. 38 1705, entre Av. 17 y Av. 17A, Nuevo Córdoba, 94550 Córdoba, Ver.
            </p>
          </div>

          <div>
            <span class="block text-xs uppercase tracking-wider text-suave">Atención y Demostraciones</span>
            <p class="mt-1 text-roto">
              Lunes a Viernes: 9:00 - 18:00 hrs
            </p>
          </div>

          <div>
            <span class="block text-xs uppercase tracking-wider text-suave">Servicios en Sitio</span>
            <ul class="mt-2 space-y-2 text-roto">
              <li class="flex items-center gap-2">
                <Icono nombre="check" class="size-4 text-marca-claro shrink-0" />
                <span>Exposición y prueba de ultrasonidos</span>
              </li>
              <li class="flex items-center gap-2">
                <Icono nombre="check" class="size-4 text-marca-claro shrink-0" />
                <span>Capacitación a personal médico</span>
              </li>
              <li class="flex items-center gap-2">
                <Icono nombre="check" class="size-4 text-marca-claro shrink-0" />
                <span>Envíos e instalación nacional</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="mt-8 pt-6 border-t border-(--linea) space-y-3">
          <a
            href={googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primario w-full text-center flex justify-center"
          >
            <Icono nombre="externo" class="size-4" />
            <span>Trazar ruta en Google Maps</span>
          </a>

          <a
            href="#contacto"
            class="btn btn-contorno w-full text-center flex justify-center text-xs"
          >
            <span>Agenda una cita presencial</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Entrada en profundidad: el mapa llega inclinado, como apoyado sobre una mesa, y se endereza con el scroll.
     Relleno solo hacia atrás: al terminar queda transform: none y el iframe recibe clics y arrastre normal. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      /* overflow: hidden vuelve a la sección un contenedor de scroll y view() mediría contra ella (no avanza);
         clip recorta el resplandor igual sin serlo. */
      section {
        overflow: clip;
      }
      .mesa {
        transform-origin: 50% 100%;
        animation: mesa-enderezar linear backwards; /* el shorthand va antes: reinicia animation-timeline */
        animation-timeline: view();
        animation-range: cover 0% cover 55vh;
      }
      .mesa-lateral {
        animation-name: mesa-lateral;
      }
    }
  }
  @keyframes mesa-enderezar {
    from {
      transform: perspective(60rem) rotateX(28deg);
    }
  }
  @keyframes mesa-lateral {
    from {
      transform: perspective(60rem) rotateX(18deg);
    }
  }
</style>
