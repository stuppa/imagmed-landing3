---
import Encabezado from './Encabezado.astro';
import Icono from './Icono.astro';
import { seccionFaq as s } from '../data/faq';
import { whatsappUrl } from '../data/contacto';

const { faq, contacto } = Astro.locals.sitio;
const visibles = faq.filter((p) => p.pregunta && p.respuesta);
const wa = whatsappUrl(contacto);
---

<section id="faq" class="pb-20 lg:pb-30" aria-labelledby="titulo-faq">
  <div
    class="contenedor border-t border-tinta/10 pt-20 lg:grid lg:grid-cols-[auto_1fr] lg:items-center lg:gap-12 lg:pt-30 xl:gap-16"
  >
    <div class="mx-auto max-w-3xl lg:mx-0 lg:max-w-none">
      <div data-reveal>
        <Encabezado etiqueta={s.etiqueta} titulo={s.titulo} id="titulo-faq" class="text-center lg:text-left" />
      </div>

      <div class="mt-12 border-t border-tinta/10" data-reveal>
        {
          visibles.map((p) => (
            <details name="faq" class="group border-b border-tinta/10">
              <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-6 py-4 text-lg font-semibold [&::-webkit-details-marker]:hidden">
                {p.pregunta}
                <span class="mas" aria-hidden="true" />
              </summary>
              <p class="texto-suave pr-12 pb-6">{p.respuesta}</p>
            </details>
          ))
        }
      </div>

      <p
        class="mt-10 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-center lg:justify-start lg:text-left"
        data-reveal
      >
        <span class="texto-suave">{s.cierre}</span>
        {
          wa ? (
            <a href={wa} target="_blank" rel="noopener" class="enlace-flecha">
              {s.ctaWhatsapp}
              <Icono nombre="flecha" />
            </a>
          ) : (
            <a href="#contacto" data-solicitud="Cotización" class="enlace-flecha">
              {s.ctaFormulario}
              <Icono nombre="flecha" />
            </a>
          )
        }
      </p>
    </div>

    {/* El reel, a buen tamaño junto a las preguntas (Inicio.astro). En celular no cabe sin alargar mucho la página. */}
    <div class="hidden lg:order-first lg:block" data-reveal>
      <slot />
    </div>
  </div>
</section>

<style>
  summary:hover {
    color: var(--color-marca);
  }
  .mas {
    position: relative;
    flex: none;
    width: 1rem;
    height: 1rem;
    color: var(--color-marca);
  }
  .mas::before,
  .mas::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1.5px;
    margin-top: -0.75px;
    background: currentColor;
    transition: rotate 0.25s ease;
  }
  .mas::after {
    rotate: 90deg;
  }
  details[open] .mas::after {
    rotate: 0deg;
  }

  @media (prefers-reduced-motion: no-preference) {
    details {
      interpolate-size: allow-keywords;
    }
    details::details-content {
      height: 0;
      overflow: clip;
      transition:
        height 0.3s ease,
        content-visibility 0.3s allow-discrete;
    }
    details[open]::details-content {
      height: auto;
    }
  }
</style>
