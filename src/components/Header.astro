---
import { Image } from 'astro:assets';
import Icono from './Icono.astro';
import wordmark from '../assets/marca/imagmed-wordmark.png';
import { encabezado, navegacion, productos, sitio } from '../data/sitio';
import { whatsappUrl } from '../data/contacto';

const { categorias, contacto } = Astro.locals.sitio;
const wa = whatsappUrl(contacto);
---

<header class="oscuro fixed inset-x-0 top-0 z-50 border-b border-(--linea) bg-negro/85 backdrop-blur-md">
  <div class="contenedor flex h-16 items-center gap-3 lg:gap-8">
    <a href="/#inicio" class="logo mr-auto shrink-0 lg:mr-0">
      <Image
        src={wordmark}
        alt={sitio.nombre}
        width={140}
        densities={[1, 2]}
        loading="eager"
        class="block h-auto w-28 sm:w-[140px]"
      />
    </a>

    <nav aria-label="Principal" class="hidden lg:mx-auto lg:block">
      <ul class="flex items-center gap-5 text-[0.9375rem] xl:gap-7">
        <li class="desplegable">
          <button type="button" class="enlace-nav gap-1">
            {productos.texto}
            <Icono nombre="chevron" class="size-4" />
          </button>
          <div class="submenu">
            <ul class="reticula">
              {
                categorias.map((c) => (
                  <li>
                    <a href={`/productos/${c.slug}`}>{c.nombre}</a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>
        {
          navegacion.map((item) => (
            <li>
              <a href={item.href} class="enlace-nav" data-nav>
                {item.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3 sm:gap-4">
      {
        wa && (
          <a href={wa} target="_blank" rel="noopener" class="btn btn-contorno btn-chico">
            <Icono nombre="whatsapp" class="size-4.5" />
            {encabezado.whatsapp}
          </a>
        )
      }
      <a
        href="#contacto"
        data-solicitud="Cotización"
        class:list={['btn btn-primario btn-chico', wa && 'hidden sm:inline-flex']}
      >
        <span class="sm:hidden">{encabezado.ctaCorto}</span>
        <span class="hidden sm:inline">{encabezado.cta}</span>
      </a>
    </div>

    <button
      type="button"
      popovertarget="menu"
      aria-label={encabezado.menu}
      class="boton-menu -mr-2 grid size-11 place-items-center lg:hidden"
    >
      <span class="barras" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>

  <nav id="menu" popover aria-label="Principal móvil" class="oscuro menu-movil">
    <ul class="contenedor pt-2">
      <li>
        <details class="productos-movil">
          <summary class="enlace-movil">
            {productos.texto}
            <Icono nombre="chevron" class="size-4" />
          </summary>
          <ul class="border-b border-(--linea) py-2">
            {
              categorias.map((c) => (
                <li>
                  <a
                    href={`/productos/${c.slug}`}
                    class="texto-suave flex min-h-11 items-center pl-4 hover:text-white"
                  >
                    {c.nombre}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
      </li>
      {
        navegacion.map((item) => (
          <li>
            <a href={item.href} class="enlace-movil" data-nav>
              {item.texto}
              <Icono nombre="flecha" class="size-4" />
            </a>
          </li>
        ))
      }
    </ul>
    <div class="contenedor grid gap-3 pt-6 pb-8 sm:grid-cols-2">
      <a href="#contacto" data-solicitud="Cotización" class="btn btn-primario">{encabezado.cta}</a>
      {
        wa && (
          <a href={wa} target="_blank" rel="noopener" class="btn btn-contorno">
            <Icono nombre="whatsapp" class="size-5" />
            {encabezado.whatsapp}
          </a>
        )
      }
    </div>
  </nav>
</header>

<style>
  /* Logo: de vez en cuando le pasa un barrido de rayos X y se «electrocuta» (RGB separado, sacudidas, franjas cortadas).
     Aquí solo la ráfaga; cuándo ocurre lo decide el script. */
  .logo {
    position: relative;
    --rx: #9edcff; /* el cian de rayos X del hover de los botones */
    --cian: #00e5ff;
    --magenta: #ff2e63;
  }
  .logo::after {
    content: '';
    position: absolute;
    inset: -0.375rem -0.5rem;
    pointer-events: none;
    opacity: 0;
    background:
      linear-gradient(90deg, transparent, color-mix(in srgb, var(--rx) 60%, transparent) 40%, #fff 50%, color-mix(in srgb, var(--rx) 60%, transparent) 60%, transparent) -50% 0 / 20% 100% no-repeat,
      repeating-linear-gradient(0deg, color-mix(in srgb, var(--rx) 16%, transparent) 0 1px, transparent 1px 3px);
    mix-blend-mode: screen;
  }
  @media (prefers-reduced-motion: no-preference) {
    .logo.glitch :global(img) {
      animation: glitch-logo 0.8s steps(1);
    }
    .logo.glitch::after {
      animation: barrido-logo 0.8s linear;
    }
  }
  @keyframes barrido-logo {
    0% {
      opacity: 1;
    }
    75% {
      opacity: 1;
      background-position: 150% 0, 0 0;
    }
    100% {
      background-position: 150% 0, 0 0;
    }
  }
  /* Con steps(1) cada cuadro se queda fijo hasta el siguiente: saltos secos, sin transiciones. */
  @keyframes glitch-logo {
    0% {
      transform: translate(-2px, 0);
      filter: drop-shadow(-3px 0 var(--cian)) drop-shadow(3px 0 var(--magenta));
    }
    6% {
      transform: translate(5px, -1px);
      clip-path: inset(0 0 55% 0);
    }
    12% {
      transform: translate(-6px, 1px) skewX(-14deg);
      clip-path: inset(48% 0 0 0);
      filter: drop-shadow(4px 0 var(--magenta)) drop-shadow(-4px 0 var(--cian));
    }
    18% {
      transform: none;
      clip-path: none;
      filter: drop-shadow(0 0 2px #fff) drop-shadow(0 0 10px var(--rx));
    }
    26% {
      transform: translate(3px, 0) skewX(18deg);
      filter: drop-shadow(-6px 0 var(--cian)) drop-shadow(6px 0 var(--magenta));
    }
    32% {
      transform: translate(-9px, 0);
      clip-path: inset(28% 0 38% 0);
    }
    38% {
      transform: translate(1px, 0);
      clip-path: none;
      opacity: 0.35;
      filter: drop-shadow(-2px 0 var(--cian)) drop-shadow(2px 0 var(--magenta));
    }
    44% {
      transform: none;
      opacity: 1;
      filter: none;
    }
    62% {
      transform: translate(7px, 0);
      clip-path: inset(66% 0 6% 0);
      filter: drop-shadow(-3px 0 var(--cian)) drop-shadow(3px 0 var(--magenta));
    }
    67% {
      transform: translate(-2px, 0);
      clip-path: none;
      filter: drop-shadow(-1px 0 var(--cian)) drop-shadow(1px 0 var(--magenta));
    }
    72% {
      transform: none;
      filter: none;
    }
  }

  .btn-chico {
    min-height: 2.75rem;
    padding-inline: 1.125rem;
    font-size: 0.75rem;
  }

  .enlace-nav {
    position: relative;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--suave);
    transition: color 0.2s ease;
  }
  .enlace-nav::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0.5rem;
    left: 0;
    height: 1px;
    background: var(--color-marca-claro);
    scale: 0 1;
    transition: scale 0.25s ease;
  }
  .enlace-nav:hover,
  .enlace-nav[aria-current] {
    color: #fff;
  }
  .enlace-nav:hover::after,
  .enlace-nav[aria-current]::after {
    scale: 1 1;
  }

  /* Submenú "Productos": abre con hover o con foco (teclado), sin JS. */
  .desplegable {
    position: relative;
  }
  .desplegable:is(:hover, :focus-within) > .enlace-nav {
    color: #fff;
  }
  .desplegable:is(:hover, :focus-within) > .enlace-nav::after {
    scale: 1 1;
  }
  .desplegable:is(:hover, :focus-within) > .enlace-nav :global(svg) {
    rotate: 180deg;
  }
  .submenu {
    position: absolute;
    top: 100%;
    left: -1.25rem;
    padding-top: 0.75rem; /* puente para que el hover no se pierda entre botón y panel */
    visibility: hidden;
    opacity: 0;
    --foco: #fff;
  }
  .desplegable:is(:hover, :focus-within) .submenu {
    visibility: visible;
    opacity: 1;
  }
  .submenu ul {
    min-width: 15rem;
    padding: 0.75rem;
    background: var(--color-marca);
    box-shadow: 0 24px 48px -16px rgb(0 0 0 / 0.6);
  }
  .submenu a {
    display: block;
    padding: 0.5rem 0.875rem;
    color: #fff;
    white-space: nowrap;
  }
  .submenu ul::before {
    --l: 1rem;
    inset: -6px;
  }
  .submenu a:hover {
    background: rgb(255 255 255 / 0.14);
  }

  .productos-movil summary {
    cursor: pointer;
    list-style: none;
  }
  .productos-movil summary::-webkit-details-marker {
    display: none;
  }
  .productos-movil[open] summary :global(svg) {
    rotate: 180deg;
  }

  .barras {
    display: grid;
    gap: 5px;
    width: 1.375rem;
  }
  .barras span {
    height: 1.5px;
    background: currentColor;
    transition:
      translate 0.25s ease,
      rotate 0.25s ease,
      opacity 0.2s ease;
  }
  header:has(.menu-movil:popover-open) .barras span:nth-child(1) {
    translate: 0 6.5px;
    rotate: 45deg;
  }
  header:has(.menu-movil:popover-open) .barras span:nth-child(2) {
    opacity: 0;
  }
  header:has(.menu-movil:popover-open) .barras span:nth-child(3) {
    translate: 0 -6.5px;
    rotate: -45deg;
  }

  .menu-movil {
    inset: 4rem 0 auto;
    width: 100%;
    max-width: none;
    max-height: calc(100dvh - 4rem);
    margin: 0;
    padding: 0;
    overflow-y: auto;
    overscroll-behavior: contain; /* al llegar al final de la lista no arrastra la página de fondo */
    border: 0;
    border-bottom: 1px solid var(--linea);
  }
  .menu-movil::backdrop {
    background: rgb(3 6 13 / 0.6);
  }
  .enlace-movil {
    display: flex;
    min-height: 3.5rem;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--linea);
    font-size: 1.25rem;
  }
  .enlace-movil :global(svg) {
    color: var(--color-marca-claro);
  }
  .enlace-movil[aria-current] {
    color: var(--color-marca-claro);
  }
  @media (width >= 64rem) {
    .menu-movil {
      display: none;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .submenu {
      translate: 0 -0.25rem;
      transition:
        opacity 0.2s ease,
        translate 0.2s ease,
        visibility 0.2s;
    }
    .desplegable:is(:hover, :focus-within) .submenu {
      translate: none;
    }
    .enlace-nav :global(svg) {
      transition: rotate 0.2s ease;
    }
    .menu-movil,
    .menu-movil::backdrop {
      transition:
        opacity 0.2s ease,
        translate 0.2s ease,
        overlay 0.2s allow-discrete,
        display 0.2s allow-discrete;
      opacity: 0;
    }
    .menu-movil {
      translate: 0 -0.5rem;
    }
    .menu-movil:popover-open,
    .menu-movil:popover-open::backdrop {
      opacity: 1;
      translate: none;
    }
    @starting-style {
      .menu-movil:popover-open,
      .menu-movil:popover-open::backdrop {
        opacity: 0;
      }
      .menu-movil:popover-open {
        translate: 0 -0.5rem;
      }
    }
  }
</style>

<script>
  // El popover nativo ya abre, cierra con Esc y con clic fuera. Aquí: cerrar al elegir un enlace o al salir con Tab.
  const menu = document.getElementById('menu');
  const boton = document.querySelector('[popovertarget="menu"]');
  menu?.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) menu.hidePopover();
  });
  menu?.addEventListener('focusout', (e) => {
    const destino = e.relatedTarget as Node | null;
    if (destino && destino !== boton && !menu.contains(destino)) menu.hidePopover();
  });

  // Al elegir una categoría, suelta el foco para que el submenú se cierre.
  document.querySelector('.submenu')?.addEventListener('click', () => (document.activeElement as HTMLElement | null)?.blur());

  // Glitch del logo: sale solo, una ráfaga cada 5–13 s al azar para que llegue «de la nada», y también al pasar el
  // cursor. Con un temporizador y no con una animación infinita, para que entre ráfagas no quede nada animándose.
  // Mientras dura una ráfaga la clase ya está puesta, así que un hover o el temporizador a media ráfaga no la cortan.
  const logo = document.querySelector('.logo');
  logo?.addEventListener('animationend', () => logo.classList.remove('glitch'));
  logo?.addEventListener('mouseenter', () => logo.classList.add('glitch'));
  const glitch = () => {
    logo?.classList.add('glitch');
    setTimeout(glitch, 5000 + Math.random() * 8000);
  };
  setTimeout(glitch, 1500);

  // Marca en la navegación la sección que está a la vista.
  const enlaces = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-nav]'));
  const secciones = document.querySelectorAll<HTMLElement>('main > section[id]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (!e.isIntersecting) continue;
          for (const a of enlaces) {
            if (a.hash === `#${e.target.id}`) a.setAttribute('aria-current', 'location');
            else a.removeAttribute('aria-current');
          }
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    secciones.forEach((s) => io.observe(s));
  }
</script>
