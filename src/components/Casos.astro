---
import Encabezado from './Encabezado.astro';
import { casos, seccionCasos as s } from '../data/casos';
---

{
  casos.length > 0 && (
    <section id="casos" class="pb-20 lg:pb-30" aria-labelledby="titulo-casos">
      <div class="contenedor border-t border-tinta/10 pt-20 lg:pt-30">
        <div data-reveal>
          <Encabezado etiqueta={s.etiqueta} titulo={s.titulo} id="titulo-casos" class="max-w-2xl" />
        </div>
        <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3" role="list" data-reveal="lista">
          {casos.map((c) => (
            <li class="border border-tinta/10 bg-white p-6 transition-[translate,box-shadow,border-color] duration-200 hover:border-marca hover:shadow-lg hover:shadow-tinta/5 motion-safe:hover:-translate-y-1 sm:p-8">
              <figure class="flex h-full flex-col">
                <blockquote class="text-lg">“{c.testimonio}”</blockquote>
                <figcaption class="texto-suave mt-auto pt-6 text-sm">
                  <span class="block font-semibold text-tinta">{c.persona}</span>
                  {c.cargo}, {c.cliente}, {c.ciudad}
                  <span class="etiqueta mt-3 block">{c.equipo}</span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
