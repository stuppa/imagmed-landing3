---
// Encabezado + rejilla de bloques con icono. La usan «Por qué Imagmed» y «Servicio técnico».
import Encabezado from './Encabezado.astro';
import Icono, { type NombreIcono } from './Icono.astro';
import { diferenciadores, seccionPorQue } from '../data/diferenciadores';

interface Props {
  id?: string;
  s?: { etiqueta: string; titulo: string; texto: string; cta: string };
  bloques?: readonly { icono: NombreIcono; titulo: string; texto: string }[];
  /** Data atributos del CTA: tipo de solicitud y opción precargada en el formulario. */
  solicitud?: string;
  equipo?: string;
  /** Bloques a la izquierda y encabezado a la derecha, para no repetir la misma composición. */
  invertido?: boolean;
}

const {
  id = 'por-que',
  s = seccionPorQue,
  bloques = diferenciadores,
  solicitud = 'Cotización',
  equipo,
  invertido = false,
} = Astro.props;
---

<section id={id} class="seccion" aria-labelledby={`titulo-${id}`}>
  <div
    class:list={[
      'contenedor grid gap-12 lg:items-center xl:gap-16',
      invertido ? 'lg:grid-cols-[auto_1fr]' : 'lg:grid-cols-[1fr_auto]',
    ]}
  >
    <div class:list={[invertido && 'lg:order-2']}>
      <div data-reveal>
        <Encabezado etiqueta={s.etiqueta} titulo={s.titulo} id={`titulo-${id}`}>
          <p class="texto-suave mt-5 max-w-md">{s.texto}</p>
          <a href="#contacto" data-solicitud={solicitud} data-equipo={equipo} class="enlace-flecha mt-6">
            {s.cta}
            <Icono nombre="flecha" />
          </a>
        </Encabezado>
      </div>

      {/* Desde lg, junto a los reels: icono al lado del título y texto a todo el ancho, para no quedar mucho más alta que ellos. */}
      <ul class="mt-12 grid gap-px sm:grid-cols-2 lg:mt-10" role="list" data-reveal="lista">
        {
          bloques.map((d) => (
            <li class="group grid grid-cols-[auto_1fr] gap-x-4 bg-roto p-5 outline outline-[color-mix(in_srgb,var(--color-tinta)_10%,var(--color-roto))] transition-colors duration-200 hover:bg-white sm:block sm:p-8 lg:grid lg:content-start lg:gap-x-3 lg:p-6">
              <Icono
                nombre={d.icono}
                class="row-span-2 mt-0.5 size-7 text-marca transition-transform duration-200 motion-safe:group-hover:-translate-y-1 sm:size-8 lg:row-span-1 lg:size-6"
              />
              <h3 class="text-lg font-semibold sm:mt-6 lg:mt-0">{d.titulo}</h3>
              <p class="texto-suave mt-1 sm:mt-2 lg:col-span-2">{d.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>

    {/* Los reels, a buen tamaño junto al texto (Inicio.astro). En celular no caben sin alargar mucho la página. */}
    <div class:list={['hidden lg:block', invertido && 'lg:order-1']} data-reveal>
      <slot />
    </div>
  </div>
</section>
