---
// Ficha de un producto. La usan /equipos/[slug] y la vista previa del admin (productos ocultos).
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Contacto from './Contacto.astro';
import Icono from './Icono.astro';
import Encabezado from './Encabezado.astro';
import Enfasis from './Enfasis.astro';
import TarjetaProducto from './TarjetaProducto.astro';
import { seccionCatalogo, sitio } from '../data/sitio';
import { cotizar, mensajeEquipo, whatsappUrl } from '../data/contacto';
import type { Producto } from '../lib/sitio';

interface Props {
  producto: Producto;
}

const { producto: equipo } = Astro.props;
const { productos, contacto } = Astro.locals.sitio;
const otrosEquipos = productos.filter((e) => e.categoria.slug === equipo.categoria.slug && e.slug !== equipo.slug);

const waUrl = whatsappUrl(contacto, mensajeEquipo(equipo.nombreCompleto));
const cotizarEquipo = cotizar(contacto, equipo.nombreCompleto);
const cta = equipo.agotado ? seccionCatalogo.ctaAgotado : seccionCatalogo.cta;
---

<Layout
  titulo={`${equipo.tipo ? `${equipo.tipo} ` : ''}${equipo.nombreCompleto} | ${sitio.nombre}`}
  descripcion={equipo.subtitulo}
>
  <Header />

  <main id="contenido" class="pt-16">
    <!-- Migas de pan / Navegación -->
    <div class="oscuro border-b border-(--linea) py-4">
      <div class="contenedor flex flex-wrap items-center justify-between gap-x-4 gap-y-7 text-sm">
        <nav aria-label="Migas de pan" class="flex items-center gap-2 texto-suave">
          <a href="/" class="-mx-1.5 -my-3 px-1.5 py-3 transition-colors hover:text-white">Inicio</a>
          <span class="opacity-40">/</span>
          <a href={`/productos/${equipo.categoria.slug}`} class="-my-3 py-3 transition-colors hover:text-white">{equipo.categoria.nombre}</a>
          <span class="opacity-40">/</span>
          <span class="text-white font-medium">{equipo.nombreCompleto}</span>
        </nav>

        <a href={`/productos/${equipo.categoria.slug}`} class="-my-3.5 inline-flex items-center gap-1.5 py-3.5 text-xs font-semibold tracking-wider text-marca-claro uppercase hover:underline">
          <Icono nombre="flecha" class="size-3.5 rotate-180" />
          <span>Volver al catálogo</span>
        </a>
      </div>
    </div>

    <!-- HERO DEL PRODUCTO -->
    <section class="oscuro relative overflow-clip py-12 lg:py-20" aria-labelledby="titulo-equipo">
      <div class="contenedor grid gap-12 lg:grid-cols-12 lg:items-center">
        <!-- Columna de texto -->
        <div class="lg:col-span-7">
          <span class="etiqueta">{equipo.tipo || equipo.categoria.nombre}</span>

          <h1 id="titulo-equipo" class="titulo-1 mt-4">
            {equipo.marca && <><Enfasis texto={equipo.marca} /> </>}<span class="text-marca-claro"><Enfasis texto={equipo.nombre} /></span>
          </h1>

          {(equipo.descuento || equipo.agotado) && (
            <p
              class:list={[
                'mt-4 inline-flex rounded-full px-3 py-1 text-sm font-bold text-white',
                equipo.agotado ? 'bg-slate-700' : 'bg-marca',
              ]}
            >
              {equipo.agotado ? seccionCatalogo.agotado : equipo.descuento}
            </p>
          )}

          <p class="mt-4 text-xl font-medium text-slate-200 leading-relaxed max-w-2xl">
            {equipo.subtitulo}
          </p>

          <p class="texto-suave mt-4 text-base leading-relaxed max-w-2xl">
            {equipo.descripcion}
          </p>

          <!-- Badges de valor -->
          <div class="mt-8 flex flex-wrap gap-2.5">
            <span class="inline-flex items-center gap-2 rounded-full border border-marca/30 bg-marca/10 px-3.5 py-1.5 text-xs font-medium text-marca-claro">
              <Icono nombre="check" class="size-3.5 flex-none" />
              Garantía Formal Imagmed
            </span>
            <span class="inline-flex items-center gap-2 rounded-full border border-slate-700 bg-slate-900/80 px-3.5 py-1.5 text-xs font-medium text-slate-300">
              <Icono nombre="check" class="size-3.5 text-marca-claro flex-none" />
              Instalación & Capacitación Incluida
            </span>
            <span class="inline-flex items-center gap-2 rounded-full border border-slate-700 bg-slate-900/80 px-3.5 py-1.5 text-xs font-medium text-slate-300">
              <Icono nombre="check" class="size-3.5 text-marca-claro flex-none" />
              Cobertura Nacional en México
            </span>
          </div>

          <!-- Acciones principales de cotización -->
          <div class="mt-10 flex flex-wrap items-center gap-4">
            <a {...cotizarEquipo} class="btn btn-primario min-h-[3.25rem] px-8 text-base shadow-lg shadow-marca/25">
              <Icono nombre="flecha" class="size-5" />
              <span>{cta}</span>
            </a>

            {waUrl && (
              <a href={waUrl} target="_blank" rel="noopener" class="btn btn-contorno min-h-[3.25rem] px-6 text-base">
                <Icono nombre="whatsapp" class="size-5 text-emerald-400" />
                <span>Consultar por WhatsApp</span>
              </a>
            )}
          </div>

          <p class="mt-3 text-xs text-slate-400">
            * Te enviamos una propuesta formal detallada sin costo ni compromiso en menos de 2 horas hábiles.
          </p>
        </div>

        <!-- Columna Visual del Producto -->
        <div class="lg:col-span-5 relative">
          <div class="tarjeta-visual relative overflow-hidden rounded-2xl border border-slate-800 bg-gradient-to-b from-slate-900/90 to-noche p-8 shadow-2xl">
            <!-- Marca de agua -->
            <span class="marca-agua-detalle" aria-hidden="true">{equipo.nombre}</span>

            <div class="relative z-10 flex flex-col items-center">
              <div class="relative w-full aspect-square max-w-[360px] mx-auto flex place-items-center justify-center">
                <Image
                  src={equipo.imagen.src}
                  width={equipo.imagen.width}
                  height={equipo.imagen.height}
                  alt={equipo.imagenAlt}
                  widths={[384, 640, 828, 1080]}
                  sizes="(min-width: 1024px) 400px, 90vw"
                  quality={80}
                  loading="eager"
                  fetchpriority="high"
                  class="h-auto w-full max-h-[340px] object-contain drop-shadow-[0_20px_35px_rgba(0,0,0,0.65)] transition-transform duration-500 hover:scale-105"
                />
              </div>

              <!-- Puntos clave rápidos -->
              {equipo.especificaciones.length > 0 && (
                <div class="mt-6 w-full border-t border-slate-800/80 pt-6">
                  <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-3">Puntos Destacados</h4>
                  <ul class="space-y-2 text-sm text-slate-300">
                    {equipo.especificaciones.map((esp) => (
                      <li class="flex items-start gap-2.5">
                        <span class="mt-1 size-1.5 rounded-full bg-marca-claro flex-none"></span>
                        <span>{esp}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ESPECIALIDADES MÉDICAS -->
    {equipo.especialidades && equipo.especialidades.length > 0 && (
      <section class="seccion bg-slate-50 border-y border-slate-200" aria-labelledby="titulo-especialidades">
        <div class="contenedor">
          <div class="max-w-2xl" data-reveal>
            <span class="text-xs font-semibold uppercase tracking-wider text-marca">Aplicaciones Clínicas</span>
            <h2 id="titulo-especialidades" class="text-2xl sm:text-3xl font-bold tracking-tight text-tinta mt-1">
              Especialidades recomendadas para {equipo.nombreCompleto}
            </h2>
            <p class="texto-suave mt-2">
              Diseñado con algoritmos de procesamiento optimizados para proporcionar alta sensibilidad diagnóstica en:
            </p>
          </div>

          <div class="mt-8 flex flex-wrap gap-3" data-reveal>
            {equipo.especialidades.map((esp) => (
              <div class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white px-5 py-3.5 shadow-xs transition-all hover:border-marca hover:shadow-md">
                <div class="grid size-8 place-items-center rounded-lg bg-marca/10 text-marca font-bold text-sm">
                  ✓
                </div>
                <span class="font-semibold text-tinta text-base">{esp}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- TECNOLOGÍAS DESTACADAS -->
    {equipo.tecnologias.length > 0 && (
      <section class="seccion" aria-labelledby="titulo-tecnologias">
        <div class="contenedor">
          <div data-reveal>
            <Encabezado
              etiqueta={equipo.tecnologiasEncabezado.etiqueta}
              titulo={equipo.tecnologiasEncabezado.titulo}
              id="titulo-tecnologias"
            >
              <p class="texto-suave mt-3 max-w-xl">{equipo.tecnologiasEncabezado.texto}</p>
            </Encabezado>
          </div>

          <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
            {equipo.tecnologias.map((tech) => (
              <div class="flex flex-col rounded-2xl border border-slate-200 bg-white p-6 transition-all hover:border-marca hover:shadow-lg">
                <div class="mb-4 inline-flex size-11 items-center justify-center rounded-xl bg-marca/10 text-marca font-bold text-lg">
                  ⚡
                </div>
                <h3 class="text-lg font-bold text-tinta tracking-tight">{tech.titulo}</h3>
                <p class="texto-suave mt-2.5 text-sm leading-relaxed flex-1">{tech.descripcion}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ESPECIFICACIONES TÉCNICAS DETALLADAS -->
    {equipo.especificacionesDetalladas.length > 0 && (
      <section class="seccion bg-slate-900 oscuro border-t border-slate-800" aria-labelledby="titulo-specs">
        <div class="contenedor">
          <div class="max-w-2xl" data-reveal>
            <span class="etiqueta">Ficha Técnica</span>
            <h2 id="titulo-specs" class="titulo-2 mt-2">
              Especificaciones de configuración <span class="text-marca-claro">{equipo.nombreCompleto}</span>
            </h2>
            <p class="texto-suave mt-3 text-base">
              Consulta las características técnicas principales. Nuestro equipo biomédico te asesora en la selección de accesorios y opciones adicionales.
            </p>
          </div>

          <div class="mt-10 grid gap-8 lg:grid-cols-3" data-reveal>
            {equipo.especificacionesDetalladas.map((grupo) => (
              <div class="rounded-2xl border border-slate-800 bg-noche/80 p-6">
                <h3 class="text-lg font-semibold text-white border-b border-slate-800 pb-3 flex items-center gap-2">
                  <span class="size-2 rounded-full bg-marca-claro"></span>
                  {grupo.categoria}
                </h3>
                <dl class="mt-4 space-y-3.5">
                  {grupo.items.map((item) => (
                    <div>
                      <dt class="text-xs font-semibold uppercase tracking-wider text-slate-400">{item.etiqueta}</dt>
                      <dd class="text-sm font-medium text-slate-200 mt-0.5">{item.valor}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- BENEFICIOS CON IMAGMED NACIONAL -->
    <section class="seccion bg-slate-100 border-y border-slate-200" aria-labelledby="titulo-beneficios">
      <div class="contenedor">
        <div class="grid gap-8 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-5" data-reveal>
            <span class="text-xs font-semibold uppercase tracking-wider text-marca">Servicio Integral</span>
            <h2 id="titulo-beneficios" class="text-3xl font-bold tracking-tight text-tinta mt-2">
              ¿Por qué adquirir tu equipo con Imagmed?
            </h2>
            <p class="texto-suave mt-4">
              No solo vendemos equipos; te acompañamos en todo el ciclo de vida de tu equipo con respaldo oficial en México.
            </p>
            <a {...cotizarEquipo} class="btn btn-primario mt-6 inline-flex">
              Cotizar propuesta formal
            </a>
          </div>

          <div class="lg:col-span-7" data-reveal>
            <div class="grid gap-4 sm:grid-cols-2">
              {equipo.incluye.map((item, idx) => (
                <div class="flex items-start gap-3.5 rounded-xl border border-slate-200/80 bg-white p-5 shadow-xs">
                  <div class="grid size-7 flex-none place-items-center rounded-full bg-emerald-100 text-emerald-700 font-bold text-xs">
                    {idx + 1}
                  </div>
                  <p class="text-sm font-medium text-slate-800 leading-snug">{item}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FORMULARIO DE COTIZACIÓN -->
    <div id="cotizar">
      <Contacto
        equipoInicial={equipo.nombreCompleto}
        tituloPersonalizado={`Solicita tu cotización formal para *${equipo.nombreCompleto}*.`}
        subtituloPersonalizado={`Completa tus datos para enviarte la propuesta económica en PDF con la configuración que necesitas. Sin compromiso ni precios ocultos.`}
      />
    </div>

    <!-- OTROS EQUIPOS RECOMENDADOS -->
    {otrosEquipos.length > 0 && (
      <section class="seccion bg-white" aria-labelledby="titulo-otros">
        <div class="contenedor">
          <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
            <div>
              <span class="text-xs font-semibold uppercase tracking-wider text-marca">Comparar Modelos</span>
              <h2 id="titulo-otros" class="text-2xl font-bold tracking-tight text-tinta mt-1">
                Otros equipos en {equipo.categoria.nombre}
              </h2>
            </div>
            <a href={`/productos/${equipo.categoria.slug}`} class="-my-3 inline-flex items-center gap-1.5 py-3 text-sm font-semibold text-marca hover:underline">
              <span>Ver todos</span>
              <Icono nombre="flecha" class="size-4" />
            </a>
          </div>

          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
            {otrosEquipos.slice(0, 3).map((e) => (
              <TarjetaProducto producto={e} />
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <!-- BARRA FLOTANTE DE COTIZACIÓN PARA MÓVIL Y SCROLL -->
  <div id="barra-cotizar-flotante" class="fixed bottom-0 inset-x-0 z-40 bg-noche/95 border-t border-slate-800 p-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur-md transition-transform duration-300 translate-y-full md:hidden">
    <div class="contenedor flex items-center justify-between gap-3">
      <div>
        <p class="text-xs text-slate-400">{equipo.tipo || equipo.categoria.nombre}</p>
        <p class="text-sm font-bold text-white leading-tight">{equipo.nombreCompleto}</p>
      </div>
      <a {...cotizarEquipo} class="btn btn-primario min-h-11 px-5 text-xs">
        {equipo.agotado ? seccionCatalogo.ctaAgotado : 'Cotizar ahora'}
      </a>
    </div>
  </div>

  <Footer />
  {/* La vista previa del admin agrega aquí su barra. */}
  <slot />
</Layout>

<style>
  .marca-agua-detalle {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 0;
    translate: -50% -50%;
    font-size: clamp(6rem, 18vw, 12rem);
    font-style: italic;
    font-weight: 900;
    line-height: 0.8;
    letter-spacing: -0.04em;
    white-space: nowrap;
    color: color-mix(in srgb, var(--color-marca) 18%, transparent);
    pointer-events: none;
    user-select: none;
  }
</style>

<script>
  // Mostrar u ocultar barra flotante de cotización en scroll móvil
  const barra = document.getElementById('barra-cotizar-flotante');
  const cotizarSeccion = document.getElementById('cotizar');

  if (barra && cotizarSeccion) {
    window.addEventListener('scroll', () => {
      const scrollPos = window.scrollY;
      const cotizarPos = cotizarSeccion.offsetTop - 400;

      if (scrollPos > 300 && scrollPos < cotizarPos) {
        barra.classList.remove('translate-y-full');
      } else {
        barra.classList.add('translate-y-full');
      }
    }, { passive: true });
  }
</script>
