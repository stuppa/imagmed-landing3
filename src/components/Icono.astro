};

export type NombreIcono = keyof typeof lineas | keyof typeof relleno;

interface Props {
  nombre: NombreIcono;
  class?: string;
}

const { nombre, class: clase } = Astro.props;
const esRelleno = nombre in relleno;
const contenido = esRelleno
  ? relleno[nombre as keyof typeof relleno]
  : lineas[nombre as keyof typeof lineas];
---

<svg
  class={clase}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill={esRelleno ? 'currentColor' : 'none'}
  stroke={esRelleno ? 'none' : 'currentColor'}
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={contenido}
/>
