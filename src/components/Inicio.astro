---
// La landing completa. La usan / y la vista previa del admin (con otro Astro.locals.sitio).
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Confianza from './Confianza.astro';
import Categorias from './Categorias.astro';
import Marcas from './Marcas.astro';
import Catalogo from './Catalogo.astro';
import Calculadora from './Calculadora.astro';
import PorQue from './PorQue.astro';
import Casos from './Casos.astro';
import Proceso from './Proceso.astro';
import Faq from './Faq.astro';
import Mapa from './Mapa.astro';
import Contacto from './Contacto.astro';
import Footer from './Footer.astro';
import Reel from './Reel.astro';
import Icono from './Icono.astro';
import { formulario } from '../data/contacto';
import { seccionServicio, servicios } from '../data/diferenciadores';
import { citaTestimonio, reels } from '../data/reels';
import { redes } from '../data/sitio';

const instagram = redes.find((r) => r.nombre === 'Instagram')?.url;
---

<Layout>
  <Header />
  <main id="contenido">
    <Hero />
    <Confianza />
    <Categorias />
    <Catalogo />
    <PorQue
      id="servicio"
      s={seccionServicio}
      bloques={servicios}
      solicitud="Servicio"
      equipo={formulario.servicio}
      invertido
    >
      <div class="flex gap-4">
        {
          [reels.agfa, reels.rayosX].map((r) => (
            <figure class="w-56 xl:w-72">
              <Reel {...r} />
              <figcaption class="texto-suave mt-3 text-sm">{r.titulo}</figcaption>
            </figure>
          ))
        }
      </div>
      <a href={instagram} target="_blank" rel="noopener" class="enlace-flecha mt-4">
        Más videos en Instagram
        <Icono nombre="externo" />
      </a>
      {/* Debajo de lg no hay espacio junto al texto: los 4 reels van en un carrusel, como el del catálogo. */}
      <div slot="carrusel" class="mt-10 lg:hidden" data-reveal>
        <div
          class="-mx-4 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto overscroll-x-contain px-4 pt-1 pb-2 [scrollbar-width:none] md:-mx-6 md:scroll-px-6 md:px-6 [&::-webkit-scrollbar]:hidden"
        >
          {
            Object.values(reels).map((r) => (
              <figure class="flex-none basis-[62%] snap-start sm:basis-64">
                <Reel {...r} />
                <figcaption class="texto-suave mt-3 text-sm">{r.titulo}</figcaption>
              </figure>
            ))
          }
        </div>
        <a href={instagram} target="_blank" rel="noopener" class="enlace-flecha mt-2">
          Más videos en Instagram
          <Icono nombre="externo" />
        </a>
      </div>
    </PorQue>
    <Calculadora />
    <PorQue>
      <figure class="w-60 xl:w-80">
        <Reel {...reels.testimonio} />
        <blockquote class="mt-4 text-lg">“{citaTestimonio.cita}”</blockquote>
        <figcaption class="texto-suave mt-2 text-sm">{citaTestimonio.fuente}</figcaption>
      </figure>
    </PorQue>
    <Casos />
    <Proceso />
    <Faq>
      <figure class="w-60 xl:w-80">
        <Reel {...reels.demo} />
        <figcaption class="texto-suave mt-3 text-sm">{reels.demo.titulo}</figcaption>
      </figure>
    </Faq>
    <Marcas />
    <Mapa />
    <Contacto />
  </main>
  <Footer />
  {/* La vista previa del admin agrega aquí su barra. */}
  <slot />
</Layout>
