---
import { Image } from 'astro:assets';
import Enfasis from './Enfasis.astro';
import { marcas } from '../data/sitio';
import { tamanoLogo } from '../lib/contenido';

const lista = Astro.locals.sitio.marcas.map((m) => ({ ...m, tamano: m.logo && tamanoLogo(m.logo.width, m.logo.height) }));
---

<section id="marcas" class="seccion bg-white text-center" aria-labelledby="titulo-marcas">
  <div class="contenedor">
    <h2 id="titulo-marcas" class="titulo-2 mx-auto max-w-[16em]" data-reveal>
      <Enfasis texto={marcas.titulo} />
    </h2>

    <ul class="logos mt-12 lg:mt-16" role="list" data-reveal="lista">
      {
        lista.map((m) => (
          <li>
            {m.logo && m.tamano ? (
              <Image
                src={m.logo.src}
                width={m.tamano.ancho}
                height={m.tamano.alto}
                widths={[128, 256, 384, 640]}
                sizes={`${m.tamano.ancho}px`}
                quality={90}
                alt={m.nombre}
                class="logo"
                style={`--alto: ${m.tamano.alto}px`}
              />
            ) : (
              <span class="nombre">{m.nombre}</span>
            )}
          </li>
        ))
      }
    </ul>

    <a href={marcas.href} class="btn btn-claro mt-12 lg:mt-16">{marcas.cta}</a>
  </div>
</section>

<style>
  .logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 2.5rem 3rem;
  }
  @media (width >= 64rem) {
    .logos {
      justify-content: space-between;
    }
  }
  /* Medida de tamanoLogo (escritorio); en celular, un poco menor. */
  .logo {
    width: auto;
    height: calc(var(--alto) * 0.8);
  }
  @media (width >= 64rem) {
    .logo {
      height: var(--alto);
    }
  }
  .nombre {
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-tinta);
  }
</style>
