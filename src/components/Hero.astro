---
import { Picture } from 'astro:assets';
import Enfasis from './Enfasis.astro';
import { hero } from '../data/sitio';
import { equipos, transductoresHero } from '../data/equipos';

const equipo = equipos.find((e) => e.slug === hero.equipo) ?? equipos[0]!;
---

<section id="inicio" class="oscuro relative overflow-clip pt-28 pb-14 md:pt-32 lg:pt-36 lg:pb-24" aria-labelledby="titulo-hero">
  <div class="contenedor hero-grid">
    <div class="hero-texto">
      <p class="etiqueta">{hero.etiqueta}</p>
      <h1 id="titulo-hero" class="titulo-1 mt-5"><Enfasis texto={hero.titulo} /></h1>
      <p class="texto-suave mt-6 max-w-[34rem] text-lg">{hero.texto}</p>
    </div>

    <div class="hero-visual">
      <span class="marca-agua" aria-hidden="true">{equipo.nombre}</span>
      <Picture
        src={equipo.imagen}
        alt={equipo.imagenAlt}
        formats={['avif']}
        fallbackFormat="webp"
        widths={[400, 640, 880, 1200]}
        sizes="(min-width: 1440px) 450px, (min-width: 1280px) 375px, (min-width: 1024px) calc(50vw - 9rem), (min-width: 768px) 360px, calc(100vw - 6.5rem)"
        loading="eager"
        fetchpriority="high"
        class="equipo"
      />
      {
        transductoresHero.length > 0 && (
          <ul class="transductores" role="list">
            {transductoresHero.map((t) => (
              <li>
                <span class="circulo">
                  <Picture
                    src={t.imagen}
                    alt=""
                    formats={['avif']}
                    fallbackFormat="webp"
                    widths={[96, 192]}
                    sizes="88px"
                    loading="eager"
                  />
                </span>
                <span class="rotulo">
                  <span class="rotulo-tipo">{hero.transductor} </span>
                  {t.modelo || t.tipo}
                </span>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="hero-acciones">
      <a href="#contacto" class="btn btn-primario" data-solicitud="Cotización">{hero.ctaPrincipal}</a>
      <a href="#contacto" class="btn btn-contorno" data-solicitud="Demo">{hero.ctaSecundario}</a>
    </div>
  </div>
</section>

<style>
  .hero-grid {
    display: grid;
    gap: 2.5rem;
  }
  .hero-acciones {
    display: grid;
    gap: 0.75rem;
  }
  @media (width >= 40rem) {
    .hero-acciones {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
    }
  }
  /* Tableta: el equipo no domina la pantalla y los botones quedan cerca. */
  @media (width >= 48rem) and (width < 64rem) {
    .hero-visual {
      width: 100%;
      max-width: 36rem;
      margin-inline: auto;
    }
  }
  @media (width >= 64rem) {
    .hero-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 1.5rem;
      row-gap: 2.5rem;
    }
    .hero-texto {
      grid-column: 1 / span 6;
      grid-row: 1;
      align-self: end;
    }
    .hero-acciones {
      grid-column: 1 / span 6;
      grid-row: 2;
      align-self: start;
    }
    .hero-visual {
      grid-column: 7 / -1;
      grid-row: 1 / span 2;
      /* En pantallas anchas el equipo crece hacia el margen derecho (hasta 4.5rem). */
      margin-right: max(-4.5rem, min(0px, (75rem - 100vw) / 2 + 1.5rem));
    }
  }

  /* Equipo + transductores en escuadra */
  .hero-visual {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    isolation: isolate;
  }
  .hero-visual::before {
    content: '';
    position: absolute;
    inset: -10% 20% -10% -15%;
    z-index: -1;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--color-marca) 55%, transparent),
      color-mix(in srgb, var(--color-marca) 12%, transparent) 60%,
      transparent
    );
  }
  .marca-agua {
    position: absolute;
    top: 50%;
    right: -0.12em;
    z-index: -1;
    translate: 0 -58%;
    font-size: clamp(8rem, 38vw, 21rem);
    font-style: italic;
    font-weight: 900;
    line-height: 0.8;
    letter-spacing: -0.04em;
    white-space: nowrap;
    color: color-mix(in srgb, var(--color-marca) 30%, transparent);
    pointer-events: none;
    user-select: none;
  }
  .equipo {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 1.5rem 2.5rem rgb(0 0 0 / 0.55));
  }

  /*
   * Líneas en escuadra: tallo desde el equipo, tramo vertical entre los centros de los círculos y un brazo a cada círculo.
   * Donde falta ancho (móvil y 1024–1279 px) el rótulo va debajo del círculo (--rotulo es su alto);
   * en tableta y desde 1280 px va a un lado (--rotulo: 0).
   */
  .transductores {
    --circulo: 3rem;
    --brazo: 0.625rem;
    --tallo: 0.75rem;
    --rotulo: 1.25rem;
    --trazo: color-mix(in srgb, var(--color-roto) 45%, transparent);
    position: relative;
    display: grid;
    gap: 0.75rem;
    margin-left: var(--tallo);
    padding-left: var(--brazo);
  }
  .transductores::before {
    content: '';
    position: absolute;
    top: calc(var(--circulo) / 2);
    bottom: calc(var(--circulo) / 2 + var(--rotulo));
    left: 0;
    border-left: 1px solid var(--trazo);
  }
  .transductores::after {
    content: '';
    position: absolute;
    top: calc(50% - var(--rotulo) / 2);
    right: 100%;
    width: var(--tallo);
    border-top: 1px solid var(--trazo);
  }
  .transductores li {
    position: relative;
    display: flex;
    width: var(--circulo);
    flex-direction: column;
    align-items: center;
  }
  .transductores li::before {
    content: '';
    position: absolute;
    top: calc(var(--circulo) / 2);
    left: calc(-1 * var(--brazo));
    width: var(--brazo);
    border-top: 1px solid var(--trazo);
  }
  .circulo {
    display: block;
    flex: none;
    width: var(--circulo);
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.25),
      0 0 2rem color-mix(in srgb, var(--color-marca) 50%, transparent);
  }
  .circulo :global(picture),
  .circulo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .circulo :global(img) {
    object-fit: contain;
    scale: 1.12;
    translate: 0 4%;
  }
  .rotulo {
    width: max-content;
    height: var(--rotulo);
    font-size: 0.625rem;
    font-weight: 600;
    line-height: var(--rotulo);
    letter-spacing: 0.12em;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .rotulo-tipo {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (width >= 64rem) and (width < 80rem) {
    .transductores {
      --circulo: 4.5rem;
      --brazo: 1rem;
      --tallo: 1.25rem;
      --rotulo: 1.5rem;
      gap: 1rem;
    }
    .rotulo {
      font-size: 0.6875rem;
      letter-spacing: 0.16em;
    }
  }
  @media (width >= 48rem) and (width < 64rem), (width >= 80rem) {
    .transductores {
      --circulo: 4.5rem;
      --brazo: 1.25rem;
      --tallo: 1.5rem;
      --rotulo: 0rem;
      gap: 1.5rem;
    }
    .transductores li {
      width: auto;
      flex-direction: row;
      gap: 0.75rem;
    }
    .rotulo {
      display: grid;
      height: auto;
      font-size: 0.8125rem;
      line-height: 1.4;
      letter-spacing: 0.18em;
      text-align: left;
    }
    .rotulo-tipo {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
      font-size: 0.6875rem;
      color: var(--suave);
    }
  }
  @media (width >= 80rem) {
    .transductores {
      --circulo: 5.5rem;
    }
  }

  /* Un solo momento orquestado: el texto sube, las líneas se trazan y los transductores aparecen.
     La foto del equipo no se anima: es el LCP. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-texto > *,
    .hero-acciones {
      animation: entrar 0.5s ease-out backwards;
    }
    .hero-texto > :nth-child(2) {
      animation-delay: 0.06s;
    }
    .hero-texto > :nth-child(3) {
      animation-delay: 0.14s;
    }
    .hero-acciones {
      animation-delay: 0.22s;
    }
    .transductores::after {
      transform-origin: left;
      animation: trazo-x 0.3s 0.2s ease-out both;
    }
    .transductores::before {
      animation: trazo-y 0.3s 0.45s ease-out both;
    }
    .transductores li::before {
      transform-origin: left;
      animation: trazo-x 0.25s 0.7s ease-out both;
    }
    .circulo,
    .rotulo {
      animation: aparecer 0.35s 0.85s ease-out both;
    }
    .transductores li + li :is(.circulo, .rotulo) {
      animation-delay: 0.95s;
    }
  }
  @keyframes trazo-x {
    from {
      scale: 0 1;
    }
  }
  @keyframes trazo-y {
    from {
      scale: 1 0;
    }
  }
  @keyframes aparecer {
    from {
      opacity: 0;
      scale: 0.85;
    }
  }
</style>
