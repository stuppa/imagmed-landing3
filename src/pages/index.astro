---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Confianza from '../components/Confianza.astro';
import Catalogo from '../components/Catalogo.astro';
import Calculadora from '../components/Calculadora.astro';
import PorQue from '../components/PorQue.astro';
import Casos from '../components/Casos.astro';
import Proceso from '../components/Proceso.astro';
import Faq from '../components/Faq.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Header />
  <main id="contenido">
    <Hero />
    <Confianza />
    <Catalogo />
    <Calculadora />
    <PorQue />
    <Casos />
    <Proceso />
    <Faq />
    <Contacto />
  </main>
  <Footer />
</Layout>
