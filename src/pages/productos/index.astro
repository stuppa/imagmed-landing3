---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Contacto from '../../components/Contacto.astro';
import Enfasis from '../../components/Enfasis.astro';
import Icono from '../../components/Icono.astro';
import TarjetaProducto from '../../components/TarjetaProducto.astro';
import { catalogoCompleto as c, productos, sitio } from '../../data/sitio';
import { prepararPagina } from '../../lib/sitio';

// Todo el catálogo en una página, agrupado por categoría en el orden del admin.
const { categorias } = await prepararPagina(Astro);
const conProductos = categorias.filter((cat) => cat.productos.length > 0);
const sinProductos = categorias.filter((cat) => cat.productos.length === 0);
---

<Layout titulo={`${c.tituloSeo} | ${sitio.nombre}`} descripcion={c.descripcion}>
  <Header />

  <main id="contenido">
    <section class="oscuro pt-28 pb-16 lg:pt-36 lg:pb-24" aria-labelledby="titulo-catalogo">
      <div class="contenedor">
        <nav aria-label="Migas de pan" class="texto-suave flex items-center gap-2 text-sm">
          <a href="/" class="-mx-1.5 -my-3 px-1.5 py-3 hover:text-white">Inicio</a>
          <span class="opacity-40">/</span>
          <span class="text-white" aria-current="page">{productos.texto}</span>
        </nav>

        <p class="etiqueta mt-12">{productos.texto}</p>
        <h1 id="titulo-catalogo" class="titulo-1 mt-4"><Enfasis texto={c.titulo} /></h1>
        <p class="texto-suave mt-6 max-w-xl text-lg">{c.descripcion}</p>

        <ul class="mt-10 flex flex-wrap gap-2" role="list" aria-label={c.saltar}>
          {
            conProductos.map((cat) => (
              <li>
                <a
                  href={`#${cat.slug}`}
                  class="inline-flex min-h-11 items-center gap-2 rounded-full border border-(--linea) px-4 text-sm text-slate-200 transition-colors hover:border-marca-claro hover:text-white"
                >
                  {cat.nombre}
                  <span class="text-xs font-semibold text-marca-claro">{cat.productos.length}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="seccion bg-white" aria-label={c.tituloSeo}>
      <div class="contenedor space-y-20 lg:space-y-28">
        {
          conProductos.map((cat) => (
            <div id={cat.slug} data-reveal>
              <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3 border-b border-slate-200 pb-6">
                <div>
                  <h2 class="text-2xl font-semibold tracking-tight text-tinta sm:text-3xl">{cat.nombre}</h2>
                  {cat.descripcion && <p class="texto-suave mt-2 max-w-2xl">{cat.descripcion}</p>}
                </div>
                <a href={`/productos/${cat.slug}`} class="enlace-flecha">
                  {c.verCategoria}
                  <Icono nombre="flecha" />
                </a>
              </div>
              <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {cat.productos.map((p) => (
                  <TarjetaProducto producto={p} />
                ))}
              </div>
            </div>
          ))
        }

        {
          sinProductos.length > 0 && (
            <div data-reveal>
              <h2 class="text-2xl font-semibold tracking-tight text-tinta sm:text-3xl">{c.otras}</h2>
              <ul class="mt-6 flex flex-wrap gap-x-8 gap-y-2" role="list">
                {sinProductos.map((cat) => (
                  <li>
                    <a href={`/productos/${cat.slug}`} class="enlace-flecha">
                      {cat.nombre}
                      <Icono nombre="flecha" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </section>

    <Contacto tituloPersonalizado={c.contacto} />
  </main>

  <Footer />
</Layout>
