---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Contacto from '../../components/Contacto.astro';
import Icono from '../../components/Icono.astro';
import { productos, sitio } from '../../data/sitio';
import { whatsappUrl } from '../../data/contacto';

type Categoria = (typeof productos.categorias)[number];

export function getStaticPaths() {
  return productos.categorias
    .filter((c) => c.slug)
    .map((categoria) => ({ params: { slug: categoria.slug }, props: { categoria } }));
}

// ponytail: página por categoría solo con descripción + formulario; agregar listado de modelos cuando el cliente los confirme.
const { categoria } = Astro.props as { categoria: Categoria };
const wa = whatsappUrl(`Hola Imagmed Nacional, me interesa una cotización de ${categoria.texto}.`);
---

<Layout titulo={`${categoria.texto} | ${sitio.nombre}`} descripcion={categoria.descripcion}>
  <Header />

  <main id="contenido">
    <section class="oscuro pt-28 pb-16 lg:pt-36 lg:pb-24" aria-labelledby="titulo-categoria">
      <div class="contenedor">
        <nav aria-label="Migas de pan" class="texto-suave flex items-center gap-2 text-sm">
          <a href="/" class="hover:text-white">Inicio</a>
          <span class="opacity-40">/</span>
          <span>{productos.texto}</span>
          <span class="opacity-40">/</span>
          <span class="text-white" aria-current="page">{categoria.texto}</span>
        </nav>

        <p class="etiqueta mt-12">{productos.texto}</p>
        <h1 id="titulo-categoria" class="titulo-1 mt-4">{categoria.texto}</h1>
        <p class="texto-suave mt-6 max-w-xl text-lg">{categoria.descripcion}</p>

        <div class="mt-10 flex flex-wrap gap-4">
          <a href="#contacto" class="btn btn-primario">Solicitar cotización</a>
          {
            wa && (
              <a href={wa} target="_blank" rel="noopener" class="btn btn-contorno">
                <Icono nombre="whatsapp" class="size-5" />
                WhatsApp
              </a>
            )
          }
        </div>
      </div>
    </section>

    <Contacto equipoInicial={categoria.texto} tituloPersonalizado={`Cotiza *${categoria.texto}* con Imagmed.`} />
  </main>

  <Footer />
</Layout>
