---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Contacto from '../../components/Contacto.astro';
import Icono from '../../components/Icono.astro';
import TarjetaProducto from '../../components/TarjetaProducto.astro';
import { productos, sitio } from '../../data/sitio';
import { whatsappUrl } from '../../data/contacto';
import { prepararPagina } from '../../lib/sitio';

const { categorias, contacto } = await prepararPagina(Astro);
const categoria = categorias.find((c) => c.slug === Astro.params.slug);
if (!categoria) return Astro.rewrite('/404');

const wa = whatsappUrl(contacto, `Hola IMAGMED NACIONAL, me interesa una cotización de ${categoria.nombre}.`);
const conProductos = categoria.productos.length > 0;
---

<Layout titulo={`${categoria.nombre} | ${sitio.nombre}`} descripcion={categoria.descripcion}>
  <Header />

  <main id="contenido">
    <section class="oscuro pt-28 pb-16 lg:pt-36 lg:pb-24" aria-labelledby="titulo-categoria">
      <div class="contenedor">
        <nav aria-label="Migas de pan" class="texto-suave flex items-center gap-2 text-sm">
          <a href="/" class="-mx-1.5 -my-3 px-1.5 py-3 hover:text-white">Inicio</a>
          <span class="opacity-40">/</span>
          <span>{productos.texto}</span>
          <span class="opacity-40">/</span>
          <span class="text-white" aria-current="page">{categoria.nombre}</span>
        </nav>

        <p class="etiqueta mt-12">{productos.texto}</p>
        <h1 id="titulo-categoria" class="titulo-1 mt-4">{categoria.nombre}</h1>
        <p class="texto-suave mt-6 max-w-xl text-lg">{categoria.descripcion}</p>

        <div class="mt-10 flex flex-wrap gap-4">
          <a href={conProductos ? '#modelos' : '#contacto'} class="btn btn-primario">
            {conProductos ? 'Ver modelos' : 'Solicitar cotización'}
          </a>
          {
            wa && (
              <a href={wa} target="_blank" rel="noopener" class="btn btn-contorno">
                <Icono nombre="whatsapp" class="size-5" />
                WhatsApp
              </a>
            )
          }
        </div>
      </div>
    </section>

    {
      conProductos && (
        <section id="modelos" class="seccion bg-white" aria-label={`Modelos de ${categoria.nombre}`}>
          <div class="contenedor grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {categoria.productos.map((p) => (
              <TarjetaProducto producto={p} />
            ))}
          </div>
        </section>
      )
    }

    <Contacto
      equipoInicial={conProductos ? undefined : categoria.nombre}
      tituloPersonalizado={`Cotiza *${categoria.nombre}* con Imagmed.`}
    />
  </main>

  <Footer />
</Layout>
