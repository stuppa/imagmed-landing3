---
import Admin from '../../../layouts/Admin.astro';
import { procesarFormulario, revisar, texto } from '../../../lib/admin';
import { formatoFecha } from '../../../lib/contenido';
import { urlImagen } from '../../../lib/supabase';
import type { FilaAjustes, FilaCampana, FilaProducto } from '../../../lib/sitio';

const supabase = Astro.locals.supabase;
// ponytail: 5 lugares fijos; si piden más, subir el número.
const LUGARES = 5;

const resultado = await procesarFormulario(Astro, async (f) => {
  revisar(
    await supabase
      .from('ajustes')
      .update({
        // En el orden de los lugares; los vacíos no cuentan y un producto repetido cuenta una vez.
        hero_productos: [...new Set(f.getAll('hero_productos').map(String).filter(Boolean))],
        hero_etiqueta: texto(f, 'hero_etiqueta'),
        hero_titulo: texto(f, 'hero_titulo'),
        hero_texto: texto(f, 'hero_texto'),
        hero_rotulo_accesorio: texto(f, 'hero_rotulo_accesorio'),
      })
      .eq('id', true),
  );
});
if (resultado instanceof Response) return resultado;

const [ajustes, productos, campanas] = (await Promise.all([
  supabase.from('ajustes').select('*').single().then(revisar),
  supabase.from('productos').select('id, nombre, estado').order('orden').then(revisar),
  supabase.from('campanas').select('*').order('inicio', { ascending: false }).then(revisar),
])) as [FilaAjustes, Pick<FilaProducto, 'id' | 'nombre' | 'estado'>[], FilaCampana[]];

const ahora = new Date();
const estado = (c: FilaCampana) =>
  new Date(c.fin) <= ahora
    ? { texto: 'Terminada', clase: '' }
    : new Date(c.inicio) <= ahora
      ? { texto: 'Activa ahora', clase: 'chip-verde' }
      : { texto: 'Programada', clase: 'chip-azul' };
---

<Admin titulo="Hero y campañas" error={resultado}>
  <form method="post" class="panel">
    <h2>Hero por defecto</h2>
    <p class="ayuda mb-4">
      Los productos que elijas rotan uno tras otro, también durante una campaña, salvo que esa campaña los apague. Estos textos se
      ven cuando no hay campaña activa, sobre el diseño de siempre.
    </p>
    <div class="rejilla">
      <fieldset class="ancho grid gap-3 rounded-lg border border-slate-200 p-4 sm:grid-cols-3 lg:grid-cols-5">
        <legend class="rotulo px-1">Productos que rotan</legend>
        {
          Array.from({ length: LUGARES }, (_, i) => (
            <label>
              {i + 1}.º
              <select name="hero_productos">
                <option value="">—</option>
                {productos.map((p) => (
                  <option value={p.id} selected={ajustes.hero_productos[i] === p.id}>
                    {p.nombre}
                    {p.estado === 'oculto' ? ' (oculto)' : ''}
                  </option>
                ))}
              </select>
            </label>
          ))
        }
        <p class="ayuda col-span-full">
          Se turnan cada 6 segundos en este orden: tus más vendidos, la promoción del mes o lo de temporada. Cada uno lleva su imagen, su
          nombre como marca de agua y sus accesorios con imagen. Con uno solo no rota; sin ninguno, va el primer producto destacado.
        </p>
        <p class="ayuda col-span-full">
          El encuadre es automático: los equipos altos (carros de ultrasonido, rayos X rodables, ortopantomógrafos) se ven en
          acercamiento, solo su parte de arriba; los demás, completos. Para que se vean bien, la foto del producto debe ser PNG sin fondo.
        </p>
      </fieldset>
      <label>
        Rótulo de los accesorios
        <input name="hero_rotulo_accesorio" value={ajustes.hero_rotulo_accesorio} placeholder="Transductor" />
        <p class="ayuda">Texto pequeño junto a cada círculo, p. ej. «Transductor».</p>
      </label>
      <label>
        Etiqueta
        <input name="hero_etiqueta" value={ajustes.hero_etiqueta} placeholder="Ultrasonido Mindray" />
      </label>
      <label class="ancho">
        Título
        <input name="hero_titulo" value={ajustes.hero_titulo} required />
        <p class="ayuda">Entre *asteriscos* va en azul: Donde la imagen se vuelve *certeza*.</p>
      </label>
      <label class="ancho">
        Texto
        <textarea name="hero_texto" rows="2">{ajustes.hero_texto}</textarea>
      </label>
    </div>
    <div class="acciones">
      <button class="btn btn-primario">Guardar</button>
      <a href="/admin/vista-previa" target="_blank" class="btn btn-secundario">Vista previa ↗</a>
    </div>
  </form>

  <section class="panel">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 class="mb-0!">Campañas</h2>
      <a href="/admin/hero/nueva" class="btn btn-primario">Nueva campaña</a>
    </div>
    <p class="ayuda mt-2">
      Durante sus fechas, su diseño cubre todo el hero y sus textos y botones reemplazan a los de arriba. Los productos siguen
      rotando encima (cada campaña puede apagarlos) y el hero toma solo los colores del diseño. Dos campañas no pueden encimarse.
    </p>
    <div class="scroll mt-4">
      <table class="tabla">
        <thead>
          <tr>
            <th colspan="2">Campaña</th>
            <th>Fechas</th>
            <th>Estado</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {
            campanas.map((c) => {
              const e = estado(c);
              return (
                <tr>
                  <td>
                    <img src={urlImagen(c.imagen.ruta)} alt="" class="miniatura w-20!" loading="lazy" />
                  </td>
                  <td>
                    <a href={`/admin/hero/${c.id}`} class="font-semibold hover:underline">
                      {c.nombre}
                    </a>
                  </td>
                  <td class="whitespace-nowrap">
                    {formatoFecha(c.inicio)} → {formatoFecha(c.fin)}
                  </td>
                  <td>
                    <span class:list={['chip', e.clase]}>{e.texto}</span>
                  </td>
                  <td class="whitespace-nowrap">
                    <a href={`/admin/hero/${c.id}`} class="enlace">
                      Editar
                    </a>
                    <span class="mx-1 opacity-30">|</span>
                    <a href={`/admin/vista-previa?campana=${c.id}`} target="_blank" class="enlace">
                      Vista previa
                    </a>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
      {campanas.length === 0 && <p class="ayuda">Aún no hay campañas.</p>}
    </div>
  </section>
</Admin>
