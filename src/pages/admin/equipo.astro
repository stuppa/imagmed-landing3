---
// Solo el super admin llega aquí (middleware). Todo pasa por la Edge Function «equipo», que vuelve a comprobarlo.
import Admin from '../../layouts/Admin.astro';
import { ErrorAdmin, llamarEquipo, procesarFormulario, texto } from '../../lib/admin';
import { formatoFecha } from '../../lib/contenido';

interface Miembro {
  id: string;
  correo: string;
  rol: 'super' | 'miembro';
  creado: string;
  ultimoAcceso: string | null;
  dosPasos: boolean;
  yo: boolean;
}

const supabase = Astro.locals.supabase;

const resultado = await procesarFormulario(Astro, async (f) => {
  await llamarEquipo(supabase, {
    accion: texto(f, 'accion'),
    id: texto(f, 'id'),
    correo: texto(f, 'correo'),
    rol: texto(f, 'rol'),
    contrasena: String(f.get('contrasena') ?? ''),
  });
});
if (resultado instanceof Response) return resultado;

let miembros: Miembro[] = [];
let errorLista = '';
try {
  miembros = (await llamarEquipo<{ miembros: Miembro[] }>(supabase, { accion: 'listar' })).miembros;
} catch (e) {
  errorLista = e instanceof ErrorAdmin ? e.message : 'No se pudo cargar el equipo.';
}
const ROLES = [
  { valor: 'miembro', texto: 'Miembro', ayuda: 'Edita productos, campañas y el resto del contenido.' },
  { valor: 'super', texto: 'Super admin', ayuda: 'Además agrega y quita miembros.' },
];
---

<Admin titulo="Equipo" error={resultado || errorLista}>
  <form method="post" class="panel">
    <h2>Agregar miembro</h2>
    <input type="hidden" name="accion" value="crear" />
    <div class="rejilla">
      <label>
        Correo
        <input type="email" name="correo" required autocomplete="off" placeholder="nombre@imagmed.mx" />
      </label>
      <label>
        Rol
        <select name="rol">
          {ROLES.map((r) => <option value={r.valor}>{r.texto} · {r.ayuda}</option>)}
        </select>
      </label>
      <div class="ancho">
        <label for="nueva-contrasena">Contraseña</label>
        <div class="mt-1.5 flex flex-wrap gap-2">
          <input
            id="nueva-contrasena"
            name="contrasena"
            required
            minlength="16"
            autocomplete="new-password"
            spellcheck="false"
            class="mt-0! min-w-0 flex-1 font-mono"
          />
          <button type="button" class="btn btn-secundario" data-generar>Generar</button>
          <button type="button" class="btn btn-secundario" data-copiar>Copiar</button>
        </div>
        <p class="ayuda">
          Mínimo 16 caracteres, con minúsculas, mayúsculas y números. Cópiala antes de agregar y compártela por un medio
          seguro. La primera vez que entre, el miembro registrará su verificación en dos pasos.
        </p>
      </div>
    </div>
    <div class="acciones">
      <button class="btn btn-primario">Agregar miembro</button>
    </div>
  </form>

  <section class="panel scroll">
    <h2>Miembros</h2>
    <table class="tabla">
      <thead>
        <tr>
          <th>Correo</th>
          <th>Rol</th>
          <th>2FA</th>
          <th>Último acceso</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {
          miembros.map((m) => (
            <tr>
              <td>
                <span class="font-semibold">{m.correo}</span>
                {m.yo && <span class="chip chip-azul ml-2">Tú</span>}
              </td>
              <td>
                <form method="post">
                  <input type="hidden" name="accion" value="rol" />
                  <input type="hidden" name="id" value={m.id} />
                  <select
                    name="rol"
                    aria-label={`Rol de ${m.correo}`}
                    disabled={m.yo}
                    onchange="this.form.requestSubmit()"
                    class="mt-0! w-auto!"
                  >
                    {ROLES.map((r) => (
                      <option value={r.valor} selected={m.rol === r.valor}>
                        {r.texto}
                      </option>
                    ))}
                  </select>
                </form>
              </td>
              <td>
                <span class:list={['chip', m.dosPasos ? 'chip-verde' : 'chip-rojo']}>{m.dosPasos ? 'Activa' : 'Pendiente'}</span>
              </td>
              <td class="whitespace-nowrap">{m.ultimoAcceso ? formatoFecha(m.ultimoAcceso) : 'Nunca'}</td>
              <td>
                <details>
                  <summary class="enlace cursor-pointer">Acciones</summary>
                  <div class="mt-3 grid gap-3">
                    <form method="post" class="flex flex-wrap items-end gap-2">
                      <input type="hidden" name="accion" value="contrasena" />
                      <input type="hidden" name="id" value={m.id} />
                      <label class="min-w-0 flex-1">
                        Nueva contraseña
                        <input name="contrasena" required minlength="16" autocomplete="new-password" spellcheck="false" class="font-mono" />
                      </label>
                      <button type="button" class="btn btn-secundario" data-generar>
                        Generar
                      </button>
                      <button type="button" class="btn btn-secundario" data-copiar>
                        Copiar
                      </button>
                      <button class="btn btn-primario">Guardar</button>
                    </form>
                    <form method="post" onsubmit="return confirm('Al volver a entrar tendrá que registrar su app autenticadora de nuevo. ¿Continuar?')">
                      <input type="hidden" name="accion" value="quitar-2fa" />
                      <input type="hidden" name="id" value={m.id} />
                      <button class="btn btn-secundario">Restablecer 2FA (perdió el celular)</button>
                    </form>
                    {!m.yo && (
                      <form method="post" onsubmit="return confirm('¿Quitar a este miembro? Pierde el acceso de inmediato.')">
                        <input type="hidden" name="accion" value="quitar" />
                        <input type="hidden" name="id" value={m.id} />
                        <button class="btn btn-peligro">Quitar del equipo</button>
                      </form>
                    )}
                  </div>
                </details>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>
</Admin>

<script>
  // Contraseña aleatoria de 20 caracteres (sin 0/O ni 1/l/I para dictarla sin errores) con minúsculas, mayúsculas y dígitos.
  const ABC = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789';
  function generar() {
    for (;;) {
      const c = Array.from(crypto.getRandomValues(new Uint32Array(20)), (n) => ABC[n % ABC.length]).join('');
      if (/[a-z]/.test(c) && /[A-Z]/.test(c) && /\d/.test(c)) return c;
    }
  }
  const campo = (b: Element) => b.closest('form')?.querySelector<HTMLInputElement>('input[name="contrasena"]');
  document.querySelectorAll('[data-generar]').forEach((b) =>
    b.addEventListener('click', () => {
      const input = campo(b);
      if (input) input.value = generar();
    }),
  );
  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((b) =>
    b.addEventListener('click', async () => {
      const input = campo(b);
      if (!input?.value) return;
      await navigator.clipboard.writeText(input.value);
      b.textContent = 'Copiada';
      setTimeout(() => (b.textContent = 'Copiar'), 1500);
    }),
  );
</script>
