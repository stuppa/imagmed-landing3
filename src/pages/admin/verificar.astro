---
// Segundo paso del acceso (2FA con app autenticadora). Si la cuenta aún no tiene autenticador,
// lo registra aquí con un QR; una vez registrado, Supabase exige 2FA para agregar otro.
import Admin from '../../layouts/Admin.astro';
import { texto } from '../../lib/admin';

const supabase = Astro.locals.supabase;
const { data: sesion } = await supabase.auth.getClaims();
if (sesion?.claims.aal === 'aal2') return Astro.redirect('/admin');

let error = '';
// Al fallar el código durante el registro se reusa el mismo QR (no se genera otro que invalide el escaneado).
let registro: { factor: string; qr: string; secreto: string } | null = null;

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const factor = texto(f, 'factor');
  const { error: e } = await supabase.auth.mfa.challengeAndVerify({
    factorId: factor,
    code: texto(f, 'codigo').replace(/\s/g, ''),
  });
  if (!e) return Astro.redirect('/admin', 303);
  error =
    e.status === 429 ? 'Demasiados intentos. Espera unos minutos.' : 'Código incorrecto o vencido. Escribe el código actual de tu app.';
  const qr = texto(f, 'qr');
  if (qr.startsWith('data:image/svg+xml')) registro = { factor, qr, secreto: texto(f, 'secreto') };
}

const { data: factores } = await supabase.auth.mfa.listFactors();
const totp = (factores?.all ?? []).filter((f) => f.factor_type === 'totp');
const verificado = totp.find((f) => f.status === 'verified');

if (!verificado && !registro) {
  // Primer acceso: limpia registros a medias y genera un QR nuevo.
  for (const f of totp) await supabase.auth.mfa.unenroll({ factorId: f.id });
  const { data, error: e } = await supabase.auth.mfa.enroll({ factorType: 'totp', issuer: 'Imagmed admin' });
  if (e || !data) error = `No se pudo iniciar el registro del autenticador: ${e?.message ?? 'sin datos'}`;
  else registro = { factor: data.id, qr: data.totp.qr_code, secreto: data.totp.secret };
}
const factor = registro?.factor ?? verificado?.id ?? '';
---

<Admin titulo={registro ? 'Activa la verificación en dos pasos' : 'Código de verificación'} error={error} sinMenu>
  {
    registro && (
      <div class="panel">
        <ol class="grid list-decimal gap-2 pl-5 text-[0.9375rem]">
          <li>Abre tu app autenticadora (Google Authenticator, 1Password, Authy…).</li>
          <li>Escanea este código QR o escribe la clave a mano.</li>
          <li>Escribe abajo el código de 6 dígitos que te muestre la app.</li>
        </ol>
        <img src={registro.qr} alt="Código QR para la app autenticadora" width="200" height="200" class="mx-auto mt-4" />
        <p class="ayuda text-center break-all">
          Clave: <code>{registro.secreto}</code>
        </p>
      </div>
    )
  }
  {
    factor && (
      <form method="post" class="panel grid gap-4">
        <input type="hidden" name="factor" value={factor} />
        {registro && (
          <>
            <input type="hidden" name="qr" value={registro.qr} />
            <input type="hidden" name="secreto" value={registro.secreto} />
          </>
        )}
        <label>
          Código de 6 dígitos
          <input
            name="codigo"
            inputmode="numeric"
            autocomplete="one-time-code"
            pattern="[0-9 ]{6,7}"
            maxlength="7"
            required
            autofocus
          />
        </label>
        <button class="btn btn-primario">Verificar</button>
      </form>
    )
  }
  <form method="post" action="/admin/salir" class="mt-4">
    <button class="ayuda underline">Cancelar y salir</button>
  </form>
</Admin>
