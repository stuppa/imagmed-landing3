---
import Ficha from '../../components/Ficha.astro';
import { prepararPagina } from '../../lib/sitio';

const { productos } = await prepararPagina(Astro);
// Solo productos visibles: uno oculto (o inexistente) da 404. El admin lo ve en /admin/vista-previa/[slug].
const producto = productos.find((p) => p.slug === Astro.params.slug);
if (!producto) return Astro.rewrite('/404');
---

<Ficha producto={producto} />
