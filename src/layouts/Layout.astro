---
import { Font, getImage } from 'astro:assets';
import { sitio } from '../data/sitio';
import '../styles/global.css';

interface Props {
  titulo?: string;
  descripcion?: string;
}

const { titulo = sitio.titulo, descripcion = sitio.descripcion } = Astro.props;
const url = (ruta: string) => new URL(ruta, Astro.site).href;

// JSON-LD: Organization + un Product por destacado, los del catálogo de la landing (sin precio ni ofertas).
const { destacados: productos, contacto } = Astro.locals.sitio;
const imagenes = await Promise.all(
  productos.map((p) =>
    getImage({
      src: p.imagen.src,
      width: 1200,
      height: Math.round((1200 * p.imagen.height) / p.imagen.width),
      format: 'webp',
    }),
  ),
);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': url('/#organizacion'),
      name: sitio.nombre,
      legalName: sitio.razonSocial,
      url: url('/'),
      logo: url('/logo-imagmed.png'),
      ...(contacto.telefono && {
        contactPoint: {
          '@type': 'ContactPoint',
          telephone: `+52 ${contacto.telefono}`,
          contactType: 'sales',
          areaServed: 'MX',
          availableLanguage: 'es',
        },
      }),
    },
    ...productos.map((e, i) => ({
      '@type': 'Product',
      name: e.nombreCompleto,
      ...(e.marca && { brand: { '@type': 'Brand', name: e.marca } }),
      category: e.tipo || e.categoria.nombre,
      image: url(imagenes[i]!.src),
      ...(e.especificaciones.length > 0 && { description: e.especificaciones.join('. ') }),
    })),
  ],
};
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={url(Astro.url.pathname)} />
    <meta name="theme-color" content="#03060D" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={url(Astro.url.pathname)} />
    <meta property="og:image" content={url(sitio.ogImagen)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={sitio.ogImagenAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-source-sans" preload />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only z-[60] bg-marca px-5 py-3 font-semibold text-white focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
      >{sitio.saltarContenido}</a
    >
    <slot />
    <script is:inline>
      // iOS solo aplica :active (la respuesta al toque de los botones) si la página escucha toques.
      document.addEventListener('touchstart', () => {}, { passive: true });
      // Entrada suave de secciones. Inline para que el contenido nunca quede oculto si falla otro script.
      (() => {
        const els = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window)) return els.forEach((el) => el.classList.add('is-visible'));
        const io = new IntersectionObserver(
          (entradas) => {
            for (const e of entradas) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
