---
import { Font, Image } from 'astro:assets';
import wordmark from '../assets/marca/imagmed-wordmark.png';
import '../styles/global.css';

interface Props {
  titulo: string;
  error?: string;
  /** Para entrar/verificar: sin menú ni botón de salir. */
  sinMenu?: boolean;
}

const { titulo, error, sinMenu = false } = Astro.props;
// El formulario se envía a la misma URL: tras un guardado exitoso trae ?guardado aunque el siguiente envío falle.
const guardado = Astro.url.searchParams.has('guardado') && !error;
const ruta = Astro.url.pathname.replace(/\/+$/, '');
const menu = [
  { texto: 'Panel', href: '/admin' },
  { texto: 'Productos', href: '/admin/productos' },
  { texto: 'Categorías', href: '/admin/categorias' },
  { texto: 'Marcas', href: '/admin/marcas' },
  { texto: 'Hero y campañas', href: '/admin/hero' },
  { texto: 'Contacto y FAQ', href: '/admin/contacto' },
  ...(Astro.locals.rol === 'super' ? [{ texto: 'Equipo', href: '/admin/equipo' }] : []),
];
const activo = (href: string) => (href === '/admin' ? ruta === '/admin' : ruta.startsWith(href));
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{titulo} · Admin Imagmed</title>
    <Font cssVariable="--font-source-sans" preload />
  </head>
  <body class:list={['admin', sinMenu && 'acceso oscuro']}>
    {
      !sinMenu && (
        <header class="oscuro border-b border-(--linea)">
          <div class="contenedor flex flex-wrap items-center gap-x-6 gap-y-2 py-3">
            <a href="/admin" class="font-bold tracking-tight">
              Imagmed <span class="texto-suave font-normal">admin</span>
            </a>
            <nav aria-label="Admin" class="flex flex-wrap gap-x-4 gap-y-1 text-[0.9375rem]">
              {menu.map((m) => (
                <a
                  href={m.href}
                  aria-current={activo(m.href) ? 'page' : undefined}
                  class="texto-suave py-1 hover:text-white aria-[current=page]:text-white aria-[current=page]:underline aria-[current=page]:underline-offset-8"
                >
                  {m.texto}
                </a>
              ))}
            </nav>
            <div class="ml-auto flex items-center gap-5 text-[0.9375rem]">
              <a href="/" target="_blank" rel="noopener" class="texto-suave hover:text-white">
                Ver sitio ↗
              </a>
              <form method="post" action="/admin/salir">
                <button class="texto-suave hover:text-white">Salir</button>
              </form>
            </div>
          </div>
        </header>
      )
    }
    <main class:list={['contenedor py-8 lg:py-12', sinMenu && 'flex min-h-dvh max-w-md flex-col justify-center']}>
      {
        sinMenu && (
          <>
            <Image src={wordmark} alt="Imagmed" width={160} densities={[1, 2]} loading="eager" class="mx-auto mb-8 h-auto w-36" />
            <p class="etiqueta mb-2 text-center">Panel de administración</p>
          </>
        )
      }
      <h1 class:list={['text-2xl font-semibold tracking-tight lg:text-3xl', sinMenu && 'text-center']}>{titulo}</h1>
      {
        guardado && (
          <p class="aviso aviso-ok" role="status">
            Guardado. El sitio público se actualiza en unos segundos.
          </p>
        )
      }
      {
        error && (
          <p class="aviso aviso-error" role="alert">
            {error}
          </p>
        )
      }
      <slot />
    </main>
    <script>
      // Al enviar: un formulario a la vez (con varios clics se subía la misma imagen varias veces) y un indicador mientras
      // guarda. Las imágenes de más de 4 MB se frenan aquí: Vercel corta el envío a los 4.5 MB con su propia página de error.
      const MAX = 4 * 1024 * 1024;
      const mb = (bytes: number) => `${(bytes / 1048576).toFixed(1)} MB`;

      addEventListener('change', (e) => {
        const input = e.target;
        if (!(input instanceof HTMLInputElement) || input.type !== 'file') return;
        const archivo = input.files?.[0];
        input.setCustomValidity(
          archivo && archivo.size > MAX ? `Pesa ${mb(archivo.size)} y el máximo es 4 MB: comprímela y vuelve a elegirla.` : '',
        );
        input.reportValidity();
      });

      addEventListener('submit', (e) => {
        const form = e.target as HTMLFormElement;
        if (e.defaultPrevented || form.method !== 'post') return;
        if (form.hasAttribute('aria-busy')) return e.preventDefault();
        const total = [...form.querySelectorAll<HTMLInputElement>('input[type="file"]')].reduce(
          (suma, i) => suma + (i.files?.[0]?.size ?? 0),
          0,
        );
        if (total > MAX) {
          e.preventDefault();
          alert(`Entre todas, las imágenes elegidas pesan ${mb(total)} y el máximo por guardado es 4 MB. Sube unas, guarda y luego las demás.`);
          return;
        }
        form.setAttribute('aria-busy', 'true');
        e.submitter?.insertAdjacentHTML('afterbegin', '<span class="girando" aria-hidden="true"></span>');
      });

      // Al volver con «atrás» el navegador puede restaurar la página tal cual la dejó: que se pueda guardar otra vez.
      addEventListener('pageshow', (e) => {
        if (!e.persisted) return;
        document.querySelectorAll('form[aria-busy]').forEach((f) => f.removeAttribute('aria-busy'));
        document.querySelectorAll('.girando').forEach((s) => s.remove());
      });
    </script>
  </body>
</html>

<style is:global>
  /* Estilos compartidos de los formularios y tablas del admin. */
  .admin {
    font-size: 1rem;
  }
  .admin .panel {
    margin-top: 1.5rem;
    padding: 1.25rem;
    border: 1px solid rgb(11 18 32 / 0.1);
    border-radius: 0.75rem;
    background: #fff;
  }
  @media (width >= 48rem) {
    .admin .panel {
      padding: 1.75rem;
    }
  }
  .admin .panel > h2 {
    margin-bottom: 1rem;
    font-size: 1.125rem;
    font-weight: 600;
  }
  .admin .rejilla {
    display: grid;
    gap: 1rem;
  }
  @media (width >= 48rem) {
    .admin .rejilla {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .admin .rejilla > .ancho {
      grid-column: 1 / -1;
    }
  }
  .admin label,
  .admin .rotulo {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .admin :is(input:not([type='checkbox'], [type='radio'], [type='file']), select, textarea) {
    display: block;
    width: 100%;
    margin-top: 0.375rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid rgb(11 18 32 / 0.2);
    border-radius: 0.5rem;
    background: #fff;
    font-weight: 400;
  }
  .admin textarea {
    min-height: 6rem;
    field-sizing: content;
  }
  .admin input[type='file'] {
    display: block;
    margin-top: 0.375rem;
    font-size: 0.875rem;
    font-weight: 400;
  }
  .admin .ayuda {
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--color-gris);
  }
  .admin .opcion {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 400;
  }
  .admin .btn {
    min-height: 2.5rem;
    padding: 0.5rem 1.25rem;
    letter-spacing: 0.08em;
  }
  .admin .btn-secundario {
    border-color: rgb(11 18 32 / 0.25);
    color: var(--color-tinta);
  }
  .admin .btn-secundario:hover {
    border-color: var(--color-tinta);
  }
  .admin .btn-peligro {
    border-color: #b42318;
    color: #b42318;
  }
  .admin .btn-peligro:hover {
    background: #b42318;
    color: #fff;
  }
  .admin .acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .admin .aviso {
    margin-top: 1rem;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.9375rem;
  }
  .admin .aviso-ok {
    background: #e7f6ec;
    color: #0f5132;
  }
  .admin .aviso-error {
    background: #fdecea;
    color: #8a1c13;
  }
  .admin .tabla {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  .admin .tabla :is(th, td) {
    padding: 0.625rem 0.5rem;
    border-bottom: 1px solid rgb(11 18 32 / 0.08);
    text-align: left;
    vertical-align: middle;
  }
  .admin .tabla th {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gris);
  }
  .admin .scroll {
    overflow-x: auto;
  }
  .admin .chip {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background: rgb(11 18 32 / 0.06);
    font-size: 0.8125rem;
    white-space: nowrap;
  }
  .admin .chip-azul {
    background: color-mix(in srgb, var(--color-marca) 12%, transparent);
    color: var(--color-marca);
  }
  .admin .chip-rojo {
    background: #fdecea;
    color: #8a1c13;
  }
  .admin .chip-verde {
    background: #e7f6ec;
    color: #0f5132;
  }
  .admin .miniatura {
    width: 3.5rem;
    height: 3.5rem;
    object-fit: contain;
    border-radius: 0.375rem;
    background: var(--color-roto);
  }
  /* Entrar y verificar: placa oscura de monitor. Solo CSS (gradientes + una animación de translate), sin imágenes extra. */
  .admin.acceso {
    color-scheme: dark; /* autocompletado y controles nativos en oscuro */
    isolation: isolate;
  }
  /* Rejilla de monitor con resplandor azul, desvanecida hacia las orillas. */
  .acceso::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 50% 40% at 50% 35%, color-mix(in srgb, var(--color-marca) 40%, transparent), transparent),
      linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px) 0 0 / 2.5rem 2.5rem,
      linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px) 0 0 / 2.5rem 2.5rem;
    mask-image: radial-gradient(ellipse at 50% 40%, #000 25%, transparent 75%);
  }
  /* Línea de escaneo que baja por la pantalla. */
  .acceso::after {
    content: '';
    position: fixed;
    inset: 0 0 auto;
    height: 40vh;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(transparent, rgb(158 220 255 / 0.06) 85%, rgb(158 220 255 / 0.3) 99%, transparent);
    translate: 0 -100%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .acceso::after {
      animation: escaneo 7s linear infinite;
    }
  }
  @keyframes escaneo {
    to {
      translate: 0 100vh;
    }
  }
  .admin.acceso .panel {
    border-color: var(--linea);
    border-radius: 0;
    background: rgb(7 18 38 / 0.85); /* --color-noche, deja ver el escaneo por detrás */
  }
  .admin.acceso :is(input:not([type='checkbox'], [type='radio'], [type='file'])) {
    min-height: 2.75rem; /* 44 px, cómodo para el dedo */
    border-color: rgb(255 255 255 / 0.18);
    background: rgb(255 255 255 / 0.04);
  }
  .admin.acceso .btn {
    min-height: 2.75rem;
  }
  .admin.acceso .aviso {
    text-align: center;
  }
  .admin.acceso .aviso-error {
    border: 1px solid rgb(255 180 171 / 0.3);
    background: rgb(180 35 24 / 0.18);
    color: #ffb4ab;
  }
  .admin.acceso .ayuda {
    color: var(--suave);
  }
  .admin.acceso .reticula + .ayuda {
    margin-top: 1rem; /* aire para la escuadra */
  }
  .admin a.enlace {
    color: var(--color-marca);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  /* Formulario guardando (script de abajo). */
  .admin form[aria-busy='true'] {
    cursor: progress;
  }
  .admin form[aria-busy='true'] :is(button, select) {
    pointer-events: none;
    opacity: 0.7;
  }
  .admin .girando {
    display: inline-block;
    flex: none;
    width: 1em;
    height: 1em;
    margin-inline-end: 0.25em;
    vertical-align: -0.125em;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .admin .girando {
      animation: girar 0.7s linear infinite;
    }
  }
  @keyframes girar {
    to {
      rotate: 1turn;
    }
  }
</style>
