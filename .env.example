# Copia este archivo como .env (no se sube al repo).
# Supabase → Project Settings → API Keys.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxx

# Solo para los scripts locales (semilla y cuenta admin). NUNCA en Vercel ni en el repo:
# da acceso total a la base, saltándose RLS.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Solo para aplicar migraciones (pnpm db:migrar, Drizzle). Connect → Direct → «Session pooler»
# (funciona con IPv4). Reemplaza [YOUR-PASSWORD] por la contraseña de la base. NUNCA en Vercel.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:CONTRASENA@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Solo para desplegar la Edge Function del equipo (pnpm funciones). supabase.com/dashboard/account/tokens
# → Generate new token. Da acceso a tu cuenta de Supabase: NUNCA en Vercel ni en el repo.
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxx
